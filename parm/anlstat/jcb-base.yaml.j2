# Search path for model and obs for JCB
# -------------------------------------
algorithm_path: "{{PARMgfs}}/gdas/jcb-algorithms"
app_path_algorithm: "{{PARMgfs}}/gdas/jcb-gdas/algorithm/obstats"
app_path_model: "{{PARMgfs}}/gdas/jcb-gdas/model/obstats"

# Assimilation window
# -------------------
window_begin: "{{ WINDOW_BEGIN | to_isotime }}"
window_YMDH: "{{ WINDOW_BEGIN | to_YMDH }}"
window_length: "{{ WINDOW_LENGTH }}"
bound_to_include: begin

stat_current_cycle_iso: "{{ current_cycle | to_isotime }}"
stat_current_cycle_YMDH: "{{ current_cycle | to_YMDH }}"

# Obspace variable things
# -----------------------
stat_aero_obsdatain_path: "{{ DATA }}/aero/diag"
stat_atmos_obsdatain_path: "{{ DATA }}/atmos/diag"
stat_atmos_gsi_obsdatain_path: "{{ DATA }}/atmos_gsi/diag"
stat_snow_obsdatain_path: "{{ DATA }}/snow/diag"

stat_aero_obsdataout_path: "{{ DATA }}/aero/stat"
stat_atmos_obsdataout_path: "{{ DATA }}/atmos/stat"
stat_atmos_gsi_obsdataout_path: "{{ DATA }}/atmos_gsi/stat"
stat_snow_obsdataout_path: "{{ DATA }}/snow/stat"
