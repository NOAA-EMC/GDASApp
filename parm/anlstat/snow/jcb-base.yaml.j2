# Search path for model and obs for JCB
# -------------------------------------
algorithm_path: "{{PARMgfs}}/gdas/jcb-algorithms"
app_path_algorithm: "{{PARMgfs}}/gdas/jcb-gdas/algorithm/obstats"
app_path_model: "{{PARMgfs}}/gdas/jcb-gdas/model/obstats/snow"

# Assimilation window
# -------------------
window_begin: "{{ WINDOW_BEGIN | to_isotime }}"
window_YMDH: "{{ WINDOW_BEGIN | to_YMDH }}"
window_length: "{{ WINDOW_LENGTH }}"
bound_to_include: begin

stat_current_cycle_iso: "{{ current_cycle | to_isotime }}"

# Obspace variable things
# -----------------------
snow_obsdatain_path: "{{ DATA }}/snow/diag"
snow_obsdatain_prefix: "diag_"
snow_obsdatain_suffix: "_{{ current_cycle | to_YMDH }}.nc"

snow_obsdataout_path: "{{ DATA }}/snow/stat"
snow_obsdataout_prefix: ""
snow_obsdataout_suffix: "_{{ current_cycle | to_YMDH }}_output_snow.nc"
