# Search path for model and obs for JCB
# -------------------------------------
algorithm_path: "{{PARMgfs}}/gdas/jcb-algorithms"
app_path_algorithm: "{{PARMgfs}}/gdas/jcb-gdas/algorithm/obstats"
app_path_observations: "{{PARMgfs}}/gdas/jcb-gdas/observations/stat_atmosphere_gsi"

# Assimilation window
# -------------------
window_begin: "{{ WINDOW_BEGIN | to_isotime }}"
window_YMDH: "{{ WINDOW_BEGIN | to_YMDH }}"
window_length: "{{ WINDOW_LENGTH }}"
bound_to_include: begin

stat_current_cycle_iso: "{{ current_cycle | to_isotime }}"

# Obspace variable things
# -----------------------
stat_atmosphere_gsi_obsdatain_path: "{{ DATA }}/atmos_gsi/diag"
stat_atmosphere_gsi_obsdatain_prefix: "diag_"
stat_atmosphere_gsi_obsdatain_suffix: "_{{ current_cycle | to_YMDH }}.nc"

stat_atmosphere_gsi_obsdataout_path: "{{ DATA }}/atmos_gsi/stat"
stat_atmosphere_gsi_obsdataout_prefix: ""
stat_atmosphere_gsi_obsdataout_suffix: "_{{ current_cycle | to_YMDH }}_output_atmos_gsi.nc"
