jedi_config:
    aero:
        rundir: '{{ DATA }}/aero'
        exe_src: '{{ EXECgfs }}/gdas_ioda-stats.x'
        mpi_cmd: '{{ APRUN_ANLSTAT }}'
        jcb_base_yaml: '{{ PARMgfs }}/gdas/anlstat/aero/jcb-base.yaml.j2'
        jcb_algo: 'anlstat'
    atmos:
        rundir: '{{ DATA }}/atmos'
        exe_src: '{{ EXECgfs }}/gdas_ioda-stats.x'
        mpi_cmd: '{{ APRUN_ANLSTAT }}'
        jcb_base_yaml: '{{ PARMgfs }}/gdas/anlstat/atmos/jcb-base.yaml.j2'
        jcb_algo: 'anlstat'
    atmos_gsi:
        rundir: '{{ DATA }}/atmos_gsi'
        exe_src: '{{ EXECgfs }}/gdas_ioda-stats.x'
        mpi_cmd: '{{ APRUN_ANLSTAT }}'
        jcb_base_yaml: '{{ PARMgfs }}/gdas/anlstat/atmos_gsi/jcb-base.yaml.j2'
        jcb_algo: 'anlstat'
    snow:
        rundir: '{{ DATA }}/snow'
        exe_src: '{{ EXECgfs }}/gdas_ioda-stats.x'
        mpi_cmd: '{{ APRUN_ANLSTAT }}'
        jcb_base_yaml: '{{ PARMgfs }}/gdas/anlstat/snow/jcb-base.yaml.j2'
        jcb_algo: 'anlstat'

data_in:
    mkdir:
{% for analysis in STAT_ANALYSES %}
    - {{ DATA }}/{{ analysis }}
    - {{ DATA }}/{{ analysis }}/diag
    - {{ DATA }}/{{ analysis }}/stat
{% endfor %}

    copy_opt:
{% for analysis in STAT_ANALYSES %}
    - ['{{ anldir[analysis] }}/{{ APREFIX }}{{ analysis }}_analysis.ioda_hofx.tar.gz', '{{ DATA }}/{{ analysis }}/diag']
{% endfor %}

data_out:
    copy_opt:
{% for analysis in STAT_ANALYSES %}
    - ['{{ DATA}}/{{ analysis }}/stat/{{ current_cycle | to_YMDH }}.ioda_hofx_stats.{{ ob }}.nc', '{{ outdir[analysis] }}']
    - ['{{ DATA }}/{{ analysis }}/{{ APREFIX }}{{ analysis }}_analysis.ioda_hofx_stats.tar.gz', '{{ outdir[analysis] }}']
{% endfor %}
