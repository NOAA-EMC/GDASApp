# Marine static-B parameters on the i-jedi MOM6 geometry (gdas_ijedi_marine_bparams.x), from the
# f009 background: horizontal scales (as soca_setcorscales), vertical scales (as soca_vtscales /
# calc_scales.py) and the parametric stddev (as soca_diagb, sea ice included), with the same
# parameter values. At 5 deg the analysis geometry is the native one, so there is no change of
# resolution.
geometry:
{% filter indent(width=2) %}
{% include 'marine_ijedi_geometry_background.yaml.j2' %}
{% endfilter %}
  # the analysis grid on the structured MOM6 grid (lon/lat, cell sizes and areas, masks, layers),
  # saved in COM as the marine analysis gridspec
  save structured grid to: ./ijedi_gridspec.nc

date: '{{ marine_window_end_iso }}'

horizontal scales:
  variables: [sea_surface_height_above_geoid]
  rossby radius:
    file: ./rossrad.nc
  area field: area
  scales:
    sea_surface_height_above_geoid:
      rossby mult: 1.0
      min grid mult: 1.0
  islands:
    # Barrier Islands between the Pamlico Sound and the Atlantic
    scale: 100.0  # in kilometers
    lat: [ 34.636, 35.065, 35.49,  35.87,  36.28]
    lon: [-76.52, -76.03, -75.46, -75.56, -75.78]
  output:
    io:
      filetype: mom6
      datapath: ./
      ocn_file: ocn.cor_rh.nc
      field io names: {sea_surface_height_above_geoid: ave_ssh}

vertical scales:
  background:
    date: '{{ marine_window_end_iso }}'
    state variables: [sea_water_cell_thickness, mom6_mld]
    io:
      filetype: mom6
      datapath: ./bkg
      ocn_file: ocean.bkg.f009.nc
      field io names: {sea_water_cell_thickness: h, mom6_mld: MLD}
  mask field: mask2d
  area field: area
  rossby radius:
    file: ./rossrad.nc
  smoothing:
    rossby mult: 1.0
    min grid mult: 2.0
    max value: 200e3
  min value: 5
  max value: 15
  output variable: sea_water_potential_temperature
  output:
    io:
      filetype: mom6
      datapath: ./
      ocn_file: vt_scales.nc
      field io names: {sea_water_potential_temperature: Temp}

{% set _bparams_vars = (marine_ijedi_background_variables + ['sea_water_cell_thickness']) | unique | list %}
{% set _uv_io_names = 'eastward_sea_water_velocity: u, northward_sea_water_velocity: v,'
                      if 'eastward_sea_water_velocity' in _bparams_vars else '' %}
background error stddev:
  variables: {{ _bparams_vars }}
  background:
    date: '{{ marine_window_end_iso }}'
    state variables: {{ _bparams_vars }}
    io:
      filetype: mom6
      datapath: ./bkg
      ocn_file: ocean.bkg.f009.nc
      ice_file: ice.bkg.f009.nc
      field io names: {sea_water_potential_temperature: Temp, sea_water_salinity: Salt,
                       sea_surface_height_above_geoid: ave_ssh, sea_water_cell_thickness: h,
                       {{ _uv_io_names }} sea_ice_area_fraction: aice_h}
      thickness from volume: {{ marine_ijedi_background_thickness_from_volume }}
{% if marine_diagb_climatology_dir is defined %}
  # The spatial std behind the dynamic T/S component is computed from the monthly
  # climatology interpolated to the cycle, not from the background (as soca_diagb): a
  # background-based sigma feeds back on itself through cycling.
  climatology:
    date: '{{ marine_window_middle_iso }}'
    mid month day: 15
    io:
      filetype: mom6
      datapath: '{{ marine_diagb_climatology_dir }}'
      ocn_file: 'ocean.clim_%MM%.nc'
      field io names: {sea_water_potential_temperature: Temp, sea_water_salinity: Salt}
{% endif %}
  # T/S settings of soca_diagb.yaml.j2 (fitted to the coupled-ensemble spread with the
  # climatology above for the dynamic component, inflated to match the ADT background error
  # through the steric balance). Without the climatology the dynamic component is roughly 2x
  # too strong. The soca_diagb sea-ice extras (fracHi/fracHs, sigHi/sigHs, max aice/hi, min
  # aice, rmax clip) are not ported: they serve the freeboard obs, not used with i-jedi yet.
  vertical e-folding scale dynamic: 1500.0
  vertical e-folding scale static: 300.0
  stencil growth iterations: 100
  min efold depth ratio: 2.0
  rescale dynamic: 0.432
  rescale static: 1.0
  # Deep floor, added in quadrature below `depth`, so that Argo/Deep Argo keep a non-zero
  # background error down to the bottom (see soca_diagb.yaml.j2)
  deep floor:
    sigT: 0.05
    sigS: 0.010
    depth: 600.0
    transition: 300.0
  static sig B:
    sigT: 0.134
    sigS: 0.0312
    sigSic: 0.02
  max ssh: 0.0   # Zero out sigb ssh: use the steric height as a strong constraint
  min depth: 100.0
  vertical bin size: 1.0
  output:
    io:
      filetype: mom6
      datapath: ./staticb
      ocn_file: ocn.bkgerr_parametric_stddev.nc
      field io names: {sea_water_potential_temperature: Temp, sea_water_salinity: Salt,
                       sea_surface_height_above_geoid: ave_ssh, sea_water_cell_thickness: h,
                       {{ _uv_io_names }} sea_ice_area_fraction: aice_h,
                       sea_ice_thickness: hi_div_aice_h, sea_ice_snow_thickness: hs_div_aice_h}
