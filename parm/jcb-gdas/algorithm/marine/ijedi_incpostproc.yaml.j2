# Marine increment postprocessing on the i-jedi MOM6 geometry (gdas_ijedi_marine_incr_handler.x):
# the i-jedi increment at the middle of the window becomes the MOM6 IAU increment (ocn.inc.nc),
# with the same QC as soca_incpostproc except that the steric height increment used by the QC comes
# from the UNESCO equation of state (no balance operator in i-jedi). The sea-ice analysis is
# postprocessed into the CICE restart (Data/<date>.cice_model.res.nc, updated in place) and its
# increment is written to ice.inc.nc.
geometry:
{% filter indent(width=2) %}
{% include 'marine_ijedi_geometry_background.yaml.j2' %}
{% endfilter %}

date: '{{ marine_window_begin_iso }}'

layers variable: [sea_water_cell_thickness]

increment variables:
- sea_water_potential_temperature
- sea_water_salinity
- sea_surface_height_above_geoid  # Not used in MOM6 iau
- sea_ice_area_fraction
- sea_ice_thickness
- sea_ice_snow_thickness

set increment variables to zero:
- eastward_sea_water_velocity
- northward_sea_water_velocity

vertical geometry:
  io:
    filetype: mom6
    datapath: ./INPUT/
    ocn_file: MOM.res.nc
    field io names: {sea_water_cell_thickness: h}

increment:
  io:
    filetype: mom6
    datapath: ./Data/
    ocn_file: 'ocn.3dvarfgat_pseudo.incr.{{ marine_window_middle_iso }}.nc'
    field io names: {{ marine_ijedi_field_io_names }}

output increment:
  io:
    filetype: mom6
    datapath: ./
    ocn_file: ocn.inc.nc
    field io names: {sea_water_potential_temperature: Temp, sea_water_salinity: Salt,
                     sea_surface_height_above_geoid: ave_ssh, eastward_sea_water_velocity: u,
                     northward_sea_water_velocity: v, sea_water_cell_thickness: h}

output ice increment:
  io:
    filetype: mom6
    datapath: ./
    ocn_file: ice.inc.nc
    field io names: {sea_ice_area_fraction: aice_h, sea_ice_thickness: hi_div_aice_h,
                     sea_ice_snow_thickness: hs_div_aice_h}

increment precision:
- field: sea_water_potential_temperature
  precision: 1.e-7
- field: sea_water_salinity
  precision: 1.e-7
- field: sea_surface_height_above_geoid  # Not used in MOM6 iau
  precision: 1.e-7
- field: sea_ice_area_fraction
  precision: 1.e-7

qc increment:
  state bounds:
    sea_water_potential_temperature: [-2.5, 36.0]
    sea_water_salinity: [0.0, 44.0]
  increment max:
    steric: 0.5
  increment stability iterations: 20
  min stable density gradient: 1e-4
  # do not test the interface with the massless layers below the bottom, whose values are fills
  skip massless interfaces: true
  steric increment:
    method: unesco

# background at the beginning of the window (the analysis, background + increment, is the target of
# the sea-ice postprocessing); sea ice from the CICE history, thicknesses derived from the volumes
background:
  date: '{{ marine_window_begin_iso }}'
  state variables:
  - sea_water_potential_temperature
  - sea_water_salinity
  - sea_surface_height_above_geoid
  - eastward_sea_water_velocity
  - northward_sea_water_velocity
  - sea_water_cell_thickness
  - sea_ice_area_fraction
  - sea_ice_thickness
  - sea_ice_snow_thickness
  derived variables: {{ marine_ijedi_background_derived_variables }}
  io:
    filetype: mom6
    datapath: ./INPUT/
    ocn_file: MOM.res.nc
    ice_file: cice.res.nc
    field io names: {sea_water_potential_temperature: Temp, sea_water_salinity: Salt,
                     sea_surface_height_above_geoid: ave_ssh, eastward_sea_water_velocity: u,
                     northward_sea_water_velocity: v, sea_water_cell_thickness: h,
                     sea_ice_area_fraction: aice_h, sea_ice_volume: hi_h,
                     sea_ice_snow_volume: hs_h}

# Sea-ice analysis postprocessing into the CICE restart (as soca_incpostproc), with the i-jedi
# "cice" io (one field per CICE restart variable, one level per category)
postprocess ice:
  ncat: 5
  ice_lev: 7
  sno_lev: 1
  cice restart:
    input:  ./Data/{{ marine_cice_date_fms }}.cice_model.res.nc
    output: ./Data/{{ marine_cice_date_fms }}.cice_model.res.nc
  snow:
    min snow thickness: 0.0001
  freeboard:
    enforce: true
  itd:
    rebin: true
    category bounds: [0.0, 0.64, 1.39, 2.47, 4.57, 1000]
