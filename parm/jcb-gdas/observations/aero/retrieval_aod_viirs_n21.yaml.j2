-

  # Observation Space (I/O)
  # -----------------------
  obs space:
    name: {{observation_from_jcb}}
    obsdatain:
      engine:
        type: H5File
        obsfile: "{{aero_obsdatain_path}}/{{aero_obsdatain_prefix}}{{observation_from_jcb}}{{aero_obsdatain_suffix}}"
        missing file action: warn
    obsdataout:
      engine:
        type: H5File
        obsfile: "{{aero_obsdataout_path}}/{{aero_obsdataout_prefix}}{{observation_from_jcb}}{{aero_obsdataout_suffix}}"
    io pool:
      max pool size: 2
    simulated variables: [aerosolOpticalDepth]
    channels: 4

  # Observation Operator
  # --------------------
  get values:
    interpolation method: barycentric
    time interpolation: linear
  obs operator:
    name: AodCRTM
    Absorbers: [H2O,O3]
    obs options:
      Sensor_ID: &{{observation_from_jcb}}_sensor_id v.viirs-m_j2
      EndianType: little_endian
      AerosolOption: aerosols_gocart_default
      CoefficientPath: "{{crtm_coefficient_path}}"
  obs error:
    covariance model: diagonal

  # Observation Bias Correction (VarBC)
  # -----------------------------------

  # Observation Filters (QC)
  # ------------------------  
  obs filters:
    - filter: PreQC
      maxvalue: 1
    - filter: Domain Check
      where:
      - variable:
          name: latitude@MetaData
        minvalue: -60
        maxvalue: 60
    - filter: Bounds Check
      filter variables:
      - name: aerosolOpticalDepth
        channels: 4
      minvalue: 0
      maxvalue: 4.9
      action:
        name: reject
    # Surface-dependent observation error: obserr = max(a1 * ObsValue + b1, a2 * ObsValue + b2)
    # MetaData/qcpathflag: 0 = ocean, 1 = bright land, 2 = dark land
    # Locations with any other qcpathflag keep the obs error from the input file.
    - filter: Variable Assignment
      where:
      - variable:
          name: MetaData/qcpathflag
        is_in: 0  # ocean
      assignments:
      - name: DerivedMetaData/aodObsError1
        channels: 4
        type: float
        function:
          name: ObsFunction/Arithmetic
          channels: 4
          options:
            variables:
            #- name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
            #  channels: 4
            coefs: [0.219923]  # a1
            intercept: 0.00784394  # b1
      - name: DerivedMetaData/aodObsError2
        channels: 4
        type: float
        function:
          name: ObsFunction/Arithmetic
          channels: 4
          options:
            variables:
            #- name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
            #  channels: 4
            coefs: [0.483]  # a2
            intercept: -0.069  # b2
    - filter: Variable Assignment
      where:
      - variable:
          name: MetaData/qcpathflag
        is_in: 2  # bright land
      assignments:
      - name: DerivedMetaData/aodObsError1
        channels: 4
        type: float
        function:
          name: ObsFunction/Arithmetic
          channels: 4
          options:
            variables:
           # - name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
          #    channels: 4
            coefs: [0.299558]  # a1
            intercept: 0.0550472  # b1
      - name: DerivedMetaData/aodObsError2
        channels: 4
        type: float
        function:
          name: ObsFunction/Arithmetic
          channels: 4
          options:
            variables:
            - name: MetaData/ObsValue_raw_4
           #   channels: 4
            coefs: [0.644]  # a2
            intercept: -0.101  # b2
    - filter: Variable Assignment
      where:
      - variable:
          name: MetaData/qcpathflag
        is_in: 1  # dark land
      assignments:
      - name: DerivedMetaData/aodObsError1
        channels: 4
        type: float
        function:
          name: ObsFunction/Arithmetic
          channels: 4
          options:
            variables:
           # - name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
           #   channels: 4
            coefs: [0.128699]  # a1
            intercept: 0.111431  # b1
      - name: DerivedMetaData/aodObsError2
        channels: 4
        type: float
        function:
          name: ObsFunction/Arithmetic
          channels: 4
          options:
            variables:
           # - name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
           #   channels: 4
            coefs: [0.547]  # a2
            intercept: -0.127  # b2
    - filter: Variable Assignment
      assignments:
      - name: DerivedMetaData/aodObsErrorDiff
        channels: 4
        type: float
        function:
          name: ObsFunction/Arithmetic
          channels: 4
          options:
            variables:
            - name: DerivedMetaData/aodObsError2
              channels: 4
            - name: DerivedMetaData/aodObsError1
              channels: 4
            coefs: [1.0, -1.0]
    - filter: Perform Action
      filter variables:
      - name: aerosolOpticalDepth
        channels: 4
      where:
      - variable:
          name: DerivedMetaData/aodObsError1
          channels: 4
        value: is_valid
      action:
        name: assign error
        error function:
          name: DerivedMetaData/aodObsError1
          channels: 4
    - filter: Perform Action
      filter variables:
      - name: aerosolOpticalDepth
        channels: 4
      where:
      - variable:
          name: DerivedMetaData/aodObsErrorDiff
          channels: 4
        minvalue: 0.0
        min_exclusive: true
      action:
        name: assign error
        error function:
          name: DerivedMetaData/aodObsError2
          channels: 4
    # Surface-dependent bias correction: BCed obs = ObsValue - (a * ObsValue + b)
    # Written to DerivedObsValue, which is used in place of ObsValue from here on;
    # the raw ObsValue is kept in the output. Initialize with the raw value so
    # locations with any other qcpathflag are left uncorrected (not set missing).
    # a = b = 0 is a no-op; set the coefficients below to turn it on.
    - filter: Variable Assignment
      assignments:
      - name: DerivedObsValue/aerosolOpticalDepth
        channels: 4
        type: float
        source variable:
          name: ObsValue/aerosolOpticalDepth
          channels: 4
    - filter: Variable Assignment
      where:
      - variable:
          name: MetaData/qcpathflag
        is_in: 0  # ocean
      assignments:
      - name: DerivedObsValue/aerosolOpticalDepth
        channels: 4
        type: float
        function:
          name: ObsFunction/Arithmetic
          channels: 4
          options:
            variables:
            #- name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
            #  channels: 4
            #- name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
            #  channels: 4
            coefs: [1.0, -0.077]  # [1, -a]
            intercept: 0.015  # -b
    - filter: Variable Assignment
      where:
      - variable:
          name: MetaData/qcpathflag
        is_in: 2  # bright land
      assignments:
      - name: DerivedObsValue/aerosolOpticalDepth
        channels: 4
        type: float
        function:
          name: ObsFunction/Arithmetic
          channels: 4
          options:
            variables:
           # - name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
           #   channels: 4
           # - name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
           #   channels: 4
            coefs: [1.0, -0.150]  # [1, -a]
            intercept: 0.011  # -b
    - filter: Variable Assignment
      where:
      - variable:
          name: MetaData/qcpathflag
        is_in: 1  # dark land
      assignments:
      - name: DerivedObsValue/aerosolOpticalDepth
        channels: 4
        type: float
        function:
          name: ObsFunction/Arithmetic
          channels: 4
          options:
            variables:
            #- name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
            #  channels: 4
           # - name: ObsValue/aerosolOpticalDepth
            - name: MetaData/ObsValue_raw_4
           #   channels: 4
            coefs: [1.0, -0.158]  # [1, -a]
            intercept: 0.014  # -b
    - filter: Background Check
      channels: 4
      threshold: 3.0
      action:
        name: inflate error
        inflation factor: 3.0
