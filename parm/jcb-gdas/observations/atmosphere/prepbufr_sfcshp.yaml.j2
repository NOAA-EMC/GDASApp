-

  # Observation Space (I/O)
  # -----------------------
  obs space:
    name: {{observation_from_jcb}}
    obsdatain:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}{{atmosphere_obsdatain_suffix}}"
        missing file action: warn
    obsdataout:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdataout_path}}/{{atmosphere_obsdataout_prefix}}{{observation_from_jcb}}{{atmosphere_obsdataout_suffix}}"
    io pool:
      max pool size: 1
    simulated variables: [stationPressure, virtualTemperature, airTemperature, specificHumidity]
    observed variables: [stationPressure, virtualTemperature, airTemperature, specificHumidity]

  # Observation Operator
  # -------------------
  obs operator:
    name: Composite
    components:
    - name: SfcCorrected
      correction scheme to use: GSL
      station_altitude: height
      geovar_sfc_geomz: height_above_mean_sea_level_at_surface
      geovar_geomz: geopotential_height
      observed temperature variable: airTemperature
      observed specific humidity variable: specificHumidity
      variables:
      - name: stationPressure
    - name: VertInterp
      vertical coordinate: air_pressure
      observation vertical coordinate: pressure
      observation vertical coordinate group: MetaData
      interpolation method: log-linear
      variables:
      - name: virtualTemperature
      - name: airTemperature
    # GSI uses the lowest model level for marine q
    - name: Identity
      variables:
      - name: specificHumidity

  # Linear Observation Operator
  # ---------------------------
  linear obs operator:
    name: Composite
    components:
    - name: Identity
      variables:
      - name: stationPressure
      - name: specificHumidity
    - name: VertInterp
      variables:
      - name: virtualTemperature
      - name: airTemperature

  # Observation Pre Filters (QC)
  # ------------------------------

{% set temperature_variables = ['virtualTemperature', 'airTemperature'] %}
{% set assim_variables = ['stationPressure'] + temperature_variables + ['specificHumidity'] %}
{% set assim_obstypes         = [180] %}

  obs pre filters:

  # remove all records not in desired obs type from obs space
  # reject all obs not of desired variable
  # --------------------------------

  - filter: Perform Action
    where:
    - variable:
        name: ObsType/{{ assim_variables[0] }}
      is_not_in: {{ assim_obstypes | join(', ') }}
    action:
      name: reduce obs space

  # Reject everything, then re-accept desired variables
  - filter: RejectList
    udescriptor: "reject_all"

{% for var in assim_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: accept
{% endfor %}

  # replace Ps with P at MSLP if ob height is 0.
  # ------------------------------

  # order matters - before the stationPressure QC, error assignment and checks
  - filter: Variable Assignment
    assignments:
    - name: DerivedObsValue/stationPressure
      type: float
      source variable:
        name: ObsValue/stationPressure
  - filter: Variable Assignment
    where:
    - variable: 
        name: MetaData/height
      minvalue: -0.0001
      maxvalue:  0.0001
    - variable:
        name: ObsValue/pressureReducedToMeanSeaLevel
      minvalue:  80000.0
      maxvalue: 120000.0
    assignments:
    - name: DerivedObsValue/stationPressure
      type: float
      source variable:
        name: ObsValue/pressureReducedToMeanSeaLevel

  # Observation Prior Filters (QC)
  # ------------------------------

  obs prior filters:

  # stationPressure QC
  # ---------------------------------

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: ObsValue/stationPressure
      maxvalue: 50000.00 # reject station pressures below 500 hPa

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: QualityMarker/stationPressure
      is_not_in: 0-3

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: QualityMarker/height
      is_in: 7, 8, 10-14

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable: MetaData/height
      value: is_not_valid

  # temperature and humidity QC
  # ---------------------------------

{% for var in temperature_variables + ['specificHumidity'] %}
  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 8-15
      value: is_not_valid
    where operator: or

  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/stationPressure
      is_in: 8-15
{% endfor %}

{% for var in temperature_variables %}
  - filter: Bounds Check
    filter variables:
    - name: {{ var }}
    minvalue: 100
    maxvalue: 400
{% endfor %}

  - filter: Bounds Check
    filter variables:
{% for var in temperature_variables + ['specificHumidity'] %}
    - name: {{ var }}
{% endfor %}
    test variables:
    - name: MetaData/pressure
    minvalue: 1.3

  - filter: Difference Check
    filter variables:
{% for var in temperature_variables %}
    - name: {{ var }}
{% endfor %}
    reference: GeoVaLs/air_pressure_at_surface
    value: MetaData/pressure
    minvalue: -1000.0
    maxvalue: 1000.0

  # reduce to keep T virtual where present, otherwise Tdry. 
  # ----------------------------------

  - filter: Perform Action
    filter variables:
    - name: airTemperature
    where:
    - variable: ObsValue/virtualTemperature
      value: is_valid
    action:
      name: reject

  # temporal thinning
  # ---------------------------------
  # TURN ON FOR TESTING l_closeobs=True (temporal filter, instead of error inflation)
  - filter: Temporal Thinning
    filter variables:
    - name: stationPressure
    category_variable: MetaData/stationIdentification
    min_spacing: PT6H
    seed_time: '{{ atmosphere_background_time_iso }}'
    action:
      name: reject

  # TURN OFF FOR TESTING, l_closeobs=False
  # order matters - compute duplicate check (here) then apply O-F check
  # using initial errors, then apply duplicate error inflation
  #- filter: Variable Assignment
  #  assignments:
  #  - name: ObsErrorFactorDuplicateCheck/stationPressure
  #    type: float
  #    function:
  #      name: ObsFunction/ObsErrorFactorDuplicateCheck
  #      options:
  #        use_air_pressure: false
  #        variable: stationPressure

  - filter: Temporal Thinning
    filter variables:
{% for var in temperature_variables %}
    - name: {{ var }}
{% endfor %}
    category_variable: MetaData/stationIdentification
    min_spacing: PT6H
    seed_time: '{{ atmosphere_background_time_iso }}'
    action:
      name: reject
 
  # to-do: revise duplicate thinning for ship-obs
  # GSI setupq treats marine q obs at the same position and pressure as
  # duplicates and keeps the one closest to the analysis time
  - filter: DuplicateThinning
    filter variables:
    - name: specificHumidity
    variable names:
    - MetaData/latitude
    - MetaData/longitude
    - MetaData/pressure
    tolerance: [1.0e-6, 1.0e-6, 1.0e-6]
    analysis_time: '{{ atmosphere_background_time_iso }}'
    min_spacing: PT6H
    action:
      name: reject

  # error assignments
  # ---------------------------------

  # set initial errors, then save
  # ---------------------------------

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorModelStepwiseLinear
        options:
          round_to_the_nearest_integer: true
          xvar:
            name: ObsValue/stationPressure
          xvals: [60000, 55000]
          errors: [130, 1.0e+11]
 
  # order matters: before conversion to q units.
  - filter: RejectList
    filter variables:
    - name: specificHumidity
    where:
    - variable: ObsErrorData/specificHumidity
      value: is_not_valid

  - filter: Perform Action
    filter variables:
    - name: specificHumidity
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorSatSpecHumidity
        options:
          variable: specificHumidity
          input_error_name: ObsErrorData

  - filter: Perform Action
    filter variables:
    - name: specificHumidity
    where:
    - variable: ObsErrorData/specificHumidity
      maxvalue: 1.0e-4
    action:
      name: assign error
      error parameter: 1.0e-4

{% for var in assim_variables %}
  - filter: Variable Assignment
    assignments:
    - name: InputObsError/{{ var }}
      type: float
      source variable: ObsErrorData/{{ var }}
{% endfor %}

  # apply error inflation terms
  # ---------------------------------

{% for var in assim_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 3, 7
    action:
      name: inflate error
      inflation factor: 1.2
{% endfor %}

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: ObsType/stationPressure
      is_in: 180
    - variable:
        name: MetaData/observationSubTypeNum
      is_in: 562, 563, 564
    action:
      name: inflate error
      inflation factor: 0.7

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    action:
      name: inflate error
      inflation variable:
        name: ObsFunction/ObsErrorFactorSfcPressure
        options:
          geovar_sfc_geomz: height_above_mean_sea_level_at_surface
          geovar_geomz: geopotential_height
          station_altitude: height
          observed temperature variable: airTemperature
          observed specific humidity variable: specificHumidity

  # order matters - do after the multiplicative error inflations
  # error += |1 - (ps/p)^(R/cp)| * 273.15 + 8 K per model level below the model surface
{% for var in temperature_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: assign error
      error function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          - name: ObsErrorData/{{ var }}
          # 1 - (ps/p)^(R/cp)
          - name: ObsFunction/Arithmetic
            options:
              variables:
              - name: ObsFunction/ElementMultiply
                options:
                  variables:
                  - name: GeoVaLs/air_pressure_at_surface
                  - name: MetaData/pressure
                  exponents: [0.2857356, -0.2857356]
                  abort if invalid operation: false
              coefs: [-1.0]
              intercept: 1.0
          - name: ObsFunction/ModelLevelsBelowSurface
          coefs: [1.0, 273.15, 8.0]
          absolute value: [false, true, false]
{% endfor %}

  # error += |1 - p/ps| * 10 (relative humidity) * qsat
  - filter: Variable Assignment
    assignments:
    - name: PressureCheckErrorRH/specificHumidity
      type: float
      function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          # 1 - p/ps
          - name: ObsFunction/Arithmetic
            options:
              variables:
              - name: ObsFunction/ElementMultiply
                options:
                  variables:
                  - name: MetaData/pressure
                  - name: GeoVaLs/air_pressure_at_surface
                  exponents: [1.0, -1.0]
                  abort if invalid operation: false
              coefs: [-1.0]
              intercept: 1.0
          coefs: [10.0]
          absolute value: [true]

  - filter: Variable Assignment
    assignments:
    - name: PressureCheckError/specificHumidity
      type: float
      function:
        name: ObsFunction/ObsErrorSatSpecHumidity
        options:
          variable: specificHumidity
          input_error_name: PressureCheckErrorRH

  - filter: Perform Action
    filter variables:
    - name: specificHumidity
    action:
      name: assign error
      error function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          - name: ObsErrorData/specificHumidity
          - name: PressureCheckError/specificHumidity

  # Observation Post Filters (QC)
  # -----------------------------

  obs post filters:

  # background checks
  # ---------------------------------

  - filter: Background Check
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_not_in: 3
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: stationPressure
        obserr_bound_min: 100
        obserr_bound_max: 300
        obserr_bound_factor: 5.0
    action:
      name: reject

  - filter: Background Check
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_in: 3
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: stationPressure
        obserr_bound_min: 100
        obserr_bound_max: 300
        obserr_bound_factor: 3.5
    action:
      name: reject

  # GSI gross check (convinfo: gross 7.0, ermin 1.3, ermax 5.6):
{% for var in temperature_variables %}
  - filter: Background Check
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_not_in: 3
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: {{ var }}
        obserr_bound_min: 1.3
        obserr_bound_max: 5.6
        obserr_bound_factor: 7.0
    action:
      name: reject

  # GSI tightens the gross limit for QM=3 obs (gross * 0.7 = 4.9)
  - filter: Background Check
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 3
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: {{ var }}
        obserr_bound_min: 1.3
        obserr_bound_max: 5.6
        obserr_bound_factor: 4.9
    action:
      name: reject
{% endfor %}

  # GSI gross check (convinfo: gross 8.0; gross*0.7 for QM=3). The convinfo
  # error bounds (10%-100% of qsat) do not bind for these obs.
  - filter: Background Check
    filter variables:
    - name: specificHumidity
    threshold: 8.0
    where:
    - variable: QualityMarker/specificHumidity
      is_not_in: 3
    action:
      name: reject

  - filter: Background Check
    filter variables:
    - name: specificHumidity
    threshold: 5.6
    where:
    - variable: QualityMarker/specificHumidity
      is_in: 3
    action:
      name: reject

  # Apply duplicate error inflation
  # ---------------------------------

  # TURN OFF FOR TESTING l_closeobs=False (temporal filter, instead of error inflation)
  # order matters - compute duplicate check, then apply O-F check
  # using initial errors, then apply duplicate error inflation (here)
  #- filter: Perform Action
  #  filter variables:
  #  - name: stationPressure
  #  action:
  #    name: inflate error
  #    inflation variable:
  #      name: ObsErrorFactorDuplicateCheck/stationPressure

  # End of Filters

  # GeoVaLs for Driving Observation Operators (testing mode)
  # --------------------------------------------------------
  geovals:
    filename: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}_geoval{{atmosphere_obsdatain_suffix}}"

  # Passed benchmark for UFO testing
  # --------------------------------
  passedBenchmark: 0
