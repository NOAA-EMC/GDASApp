-

  # Observation Space (I/O)
  # -----------------------
  obs space:
    name: {{observation_from_jcb}}
    obsdatain:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}{{atmosphere_obsdatain_suffix}}"
        missing file action: warn
    obsdataout:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdataout_path}}/{{atmosphere_obsdataout_prefix}}{{observation_from_jcb}}{{atmosphere_obsdataout_suffix}}"
    io pool:
      max pool size: 1
    simulated variables: [stationPressure, airTemperatureAt2M]
    observed variables: [stationPressure, airTemperatureAt2M]

  # Observation Operator
  # -------------------
  obs operator:
    name: Composite
    components:
    - name: SfcCorrected
      correction scheme to use: GSL
      station_altitude: height
      geovar_sfc_geomz: height_above_mean_sea_level_at_surface
      geovar_geomz: geopotential_height
      variables:
      - name: stationPressure
    - name: Identity
      variables:
      - name: airTemperatureAt2M

  # Linear Observation Operator
  # ---------------------------
  linear obs operator:
    name: Identity
    variable maps:
    - name: airTemperatureAt2M
      alias: air_temperature
      variables:
      - name: stationPressure
      - name: airTemperatureAt2M

  # Observation Prior Filters (QC)
  # ------------------------------

  obs prior filters:
  # Keep only Ps for 181, 187
  - filter: RejectList
    udescriptor: "obs_type_check_ps"
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: ObsType/stationPressure
      is_not_in: 181, 187

  # stationPressure error assignments
  # ---------------------------------
  - filter: Perform Action
    filter variables:
    - name: stationPressure
    where:
    - variable: ObsType/stationPressure
      is_in: [181]
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorModelStepwiseLinear
        options:
          round_to_the_nearest_integer: true
          xvar:
            name: ObsValue/stationPressure
          xvals: [80000, 75000, 60000, 55000]
          errors: [110, 120, 120, 1.0e+11]

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    where:
    - variable: ObsType/stationPressure
      is_in: [187]
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorModelStepwiseLinear
        options:
          round_to_the_nearest_integer: true
          xvar:
            name: ObsValue/stationPressure
          xvals: [85000, 80000, 60000, 55000]
          errors: [120, 140, 140, 1.0e+11]

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    where:
    - variable: ObsType/stationPressure
      is_in: [180]
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorModelStepwiseLinear
        options:
          round_to_the_nearest_integer: true
          xvar:
            name: ObsValue/stationPressure
          xvals: [60000, 55000]
          errors: [130, 1.0e+11]

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    where:
    - variable: ObsType/stationPressure
      is_in: [120]
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorModelStepwiseLinear
        options:
          round_to_the_nearest_integer: true
          xvar:
            name: ObsValue/stationPressure
          xvals: [80000, 75000, 60000, 55000]
          errors: [110, 120, 120, 1.0e+11]

  # save initial error assignmnet
  - filter: Variable Assignment
    assignments:
    - name: InputObsError/stationPressure
      type: float
      source variable: ObsErrorData/stationPressure
 
  # Adjustments to obs errors
  - filter: Perform Action
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_in: 3
    action:
      name: inflate error
      inflation factor: 1.2
 
  - filter: Perform Action
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: ObsType/stationPressure
      is_in: 180
    - variable:
        name: MetaData/observationSubTypeNum
      is_in: 0
    action:
      name: inflate error
      inflation factor: 0.7

  ###############################################
  # TEMPERATURE PRE-FILTERS
  ###############################################

  - filter: RejectList
    udescriptor: "obs_type_check"
    filter variables:
    - name: airTemperatureAt2M
    where:
    - variable:
        name: ObsType/airTemperatureAt2M
      is_not_in: 181
  - filter: RejectList
    filter variables:
    - name: airTemperatureAt2M
    where:
    - variable:
        name: MetaData/stationIdentification
      is_in: {{ get_conventional_rejected_stations(observation_from_jcb, 'airTemperatureAt2M') }}

  # Observation Post Filters (QC)
  # -----------------------------
  obs post filters:

  # Compute and apply inflation factor from model-observation terrain mismatch
  - filter: Variable Assignment
    assignments:
    - name: ObsErrorFactorSfcPressure/stationPressure
      type: float
      function:
        name: ObsFunction/ObsErrorFactorSfcPressure
        options:
          geovar_sfc_geomz: height_above_mean_sea_level_at_surface
          geovar_geomz: geopotential_height
          station_altitude: height

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    action:
      name: inflate error
      inflation variable:
        name: ObsErrorFactorSfcPressure/stationPressure

  # retaining GSI order: compute duplicate check, apply O-F check 
  # using initial errors, then apply duplicate error inflation
  - filter: Variable Assignment
    assignments:
    - name: ObsErrorFactorDuplicateCheck/stationPressure
      type: float
      function:
        name: ObsFunction/ObsErrorFactorDuplicateCheck
        options:
          use_air_pressure: false
          variable: stationPressure

  # Compute and apply background-check for non-QM=3 pressure obs
  - filter: Variable Assignment
    assignments:
    - name: DerivedMetaData/ObsErrorBoundSfcPressure1
      type: float
      function:
        name: ObsFunction/ObsErrorBoundConventional
        options:
          obsvar: stationPressure
          obserr_bound_min: 100
          obserr_bound_max: 300
          obserr_bound_factor: 5.0

  - filter: Background Check
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_not_in: 3
    function absolute threshold:
    - name: DerivedMetaData/ObsErrorBoundSfcPressure1
    action:
      name: reject

   # Compute and apply background-check for QM=3 pressure obs
  - filter: Variable Assignment
    assignments:
    - name: DerivedMetaData/ObsErrorBoundSfcPressure2
      type: float
      function:
        name: ObsFunction/ObsErrorBoundConventional
        options:
          obsvar: stationPressure
          obserr_bound_min: 100
          obserr_bound_max: 300
          obserr_bound_factor: 3.5

  # Reject QM=3 pressure obs with large background departures
  - filter: Background Check
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_in: 3
    function absolute threshold:
    - name: DerivedMetaData/ObsErrorBoundSfcPressure2
    action:
      name: reject

  # Inflate obs error based on duplicate check
  - filter: Perform Action
    filter variables:
    - name: stationPressure
    action:
      name: inflate error
      inflation variable:
        name: ObsErrorFactorDuplicateCheck/stationPressure

  # Reject defined station pressure values below 50000 Pa
  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: ObsValue/stationPressure
      is_defined:
    - variable:
        name: ObsValue/stationPressure
      maxvalue: 50000.00
    where operator: and

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: QualityMarker/stationPressure
      is_not_in: 0-3
  - filter: RejectList
    filter variables:
    - name: airTemperatureAt2M
  # End of Filters


  # GeoVaLs for Driving Observation Operators (testing mode)
  # --------------------------------------------------------
  geovals:
    filename: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}_geoval{{atmosphere_obsdatain_suffix}}"

  # Passed benchmark for UFO testing
  # --------------------------------
  passedBenchmark: 0

