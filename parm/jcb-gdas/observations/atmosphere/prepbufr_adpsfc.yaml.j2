-

  # Observation Space (I/O)
  # -----------------------
  obs space:
    name: {{observation_from_jcb}}
    obsdatain:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}{{atmosphere_obsdatain_suffix}}"
        missing file action: warn
    obsdataout:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdataout_path}}/{{atmosphere_obsdataout_prefix}}{{observation_from_jcb}}{{atmosphere_obsdataout_suffix}}"
    io pool:
      max pool size: 1
    simulated variables: [stationPressure, airTemperatureAt2M, specificHumidityAt2M]
    observed variables: [stationPressure, airTemperatureAt2M, specificHumidityAt2M]

  # Observation Operator
  # -------------------
  obs operator:
    name: Composite
    components:
    - name: SfcCorrected
      correction scheme to use: GSL
      station_altitude: height
      geovar_sfc_geomz: height_above_mean_sea_level_at_surface
      geovar_geomz: geopotential_height
      observed temperature variable: MetaData/airTemperatureAt2MObserved
      variables:
      - name: stationPressure
    - name: Identity
      variables:
      - name: airTemperatureAt2M
      - name: specificHumidityAt2M

  # Linear Observation Operator
  # ---------------------------

  linear obs operator:
    name: Identity
    variable maps:
    - name: airTemperatureAt2M
      alias: air_temperature
    - name: specificHumidityAt2M
      alias: water_vapor_mixing_ratio_wrt_moist_air
    variables:
    - name: stationPressure
    - name: airTemperatureAt2M
    - name: specificHumidityAt2M

  # Observation Pre Filters (QC)
  # ------------------------------

{% set variables_2m = ['airTemperatureAt2M', 'specificHumidityAt2M'] %}
{% set assim_variables = ['stationPressure', ] + variables_2m %}
{% set assim_obstypes         = [181, 187] %}

{# Prepbufr from the v16 workflow has QM=9 and no obs error for (nearly) all 2m obs. #}
{# This flag sets T2m and q2m obs with QM=9 to QM=2 and assign errors of 2.0 K and #}
{# 0.1 (relative humidity fraction). This is equivalent to GSI's ignore_2mQM flag. #}
{% set ignore_2mQM_from_v16_prepbufr = ignore_2mQM_from_v16_prepbufr | default(true) %}

  obs pre filters:

  # remove all records not in desired obs type from obs space
  # reject all obs not of desired variable
  # --------------------------------

  - filter: Perform Action
    where:
    - variable:
        name: ObsType/{{ assim_variables[0] }}
      is_not_in: {{ assim_obstypes | join(', ') }}
    action:
      name: reduce obs space

  # Reject everything, then re-accept desired variables
  - filter: RejectList
    udescriptor: "reject_all"

{% for var in assim_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: accept
{% endfor %}

{% for var in variables_2m %}
  # save 2m obs before terrain-adjustment
  - filter: Variable Assignment
    assignments:
    - name: MetaData/{{ var }}Observed
      type: float
      source variable: ObsValue/{{ var }}
      skip derived: true
{% endfor %}

{% if ignore_2mQM_from_v16_prepbufr %}
{% set qm9_obs_errors = {'airTemperatureAt2M': 2.0, 'specificHumidityAt2M': 0.1} %}
{% for var in variables_2m %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 9
    action:
      name: assign error
      error parameter: {{ qm9_obs_errors[var] }}

  - filter: Variable Assignment
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 9
    assignments:
    - name: QualityMarker/{{ var }}
      type: int
      value: 2
{% endfor %}
{% endif %}

  # Observation Prior Filters (QC)
  # ------------------------------

  obs prior filters:

  # stationPressure QC
  # ---------------------------------

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: ObsValue/stationPressure
      maxvalue: 50000.00 # reject station pressures below 500 hPa

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: QualityMarker/stationPressure
      is_not_in: 0-3

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: QualityMarker/height
      is_in: 7, 8, 10-14

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable: MetaData/height
      value: is_not_valid

  # temperature and humidity QC
  # ---------------------------------

  # same reject list for both variables
  - filter: RejectList
    filter variables:
    - name: airTemperatureAt2M
    - name: specificHumidityAt2M
    where:
    - variable:
        name: MetaData/stationIdentification
      is_in: {{ get_conventional_rejected_stations(observation_from_jcb, 'airTemperatureAt2M') }}

{% for var in variables_2m %}
  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 8-15
      value: is_not_valid
    where operator: or

  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/stationPressure
      is_in: 8-15
{% endfor %}

# to-do: replace with land_frac
# to-do: check for land for GSI Ps
{% for var in variables_2m %}
  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: GeoVaLs/slmsk
      maxvalue: 0.5
    - variable: GeoVaLs/slmsk
      minvalue: 1.5
    where operator: or
{% endfor %}

  - filter: Bounds Check
    filter variables:
    - name: airTemperatureAt2M
    minvalue: 100
    maxvalue: 400

  - filter: Variable Assignment
    assignments:
    - name: DerivedMetaData/stationMinusModelHeight
      type: float
      function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          - name: MetaData/stationElevation
          - name: GeoVaLs/height_above_mean_sea_level_at_surface
          coefs: [1.0, -1.0]

  - filter: RejectList
    filter variables:
    - name: airTemperatureAt2M
    - name: specificHumidityAt2M
    where:
    - variable: DerivedMetaData/stationMinusModelHeight
      maxvalue: -300.0
    - variable: DerivedMetaData/stationMinusModelHeight
      minvalue: 300.0
    - variable: DerivedMetaData/stationMinusModelHeight
      value: is_not_valid
    where operator: or

  # temporal thinning
  # ---------------------------------
  # TURN ON FOR TESTING l_closeobs=True (temporal filter, instead of error inflation)
{% for var in assim_variables %}
  - filter: Temporal Thinning
    filter variables:
    - name: {{ var }}
    category_variable: MetaData/stationIdentification
    min_spacing: PT6H
    seed_time: '{{ atmosphere_background_time_iso }}'
    action:
      name: reject
{% endfor %}

  # TURN OFF FOR TESTING, l_closeobs=False
  # order matters - compute duplicate check (here) then apply O-F check
  # using initial errors, then apply duplicate error inflation
  #- filter: Variable Assignment
  #  assignments:
  #  - name: ObsErrorFactorDuplicateCheck/stationPressure
  #    type: float
  #    function:
  #      name: ObsFunction/ObsErrorFactorDuplicateCheck
  #      options:
  #        use_air_pressure: false
  #        variable: stationPressure

  # to do - add duplicate check for T and q

  # error assignments
  # ---------------------------------

  # set initial errors, then save
  # ---------------------------------

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    where:
    - variable: ObsType/stationPressure
      is_in: 181
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorModelStepwiseLinear
        options:
          round_to_the_nearest_integer: true
          xvar:
            name: ObsValue/stationPressure
          xvals: [80000, 75000, 60000, 55000]
          errors: [110, 120, 120, 1.0e+11]

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    where:
    - variable: ObsType/stationPressure
      is_in: 187
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorModelStepwiseLinear
        options:
          round_to_the_nearest_integer: true
          xvar:
            name: ObsValue/stationPressure
          xvals: [85000, 80000, 60000, 55000]
          errors: [120, 140, 140, 1.0e+11]
 
  # order matters: before conversion to q units 
  - filter: RejectList
    filter variables:
    - name: specificHumidityAt2M
    where:
    - variable: ObsErrorData/specificHumidityAt2M
      value: is_not_valid

  # convert into specific humidity units, by *qsat_mod
  - filter: Variable Assignment
    assignments:
    - name: RelativeHumidityObsError/specificHumidityAt2M
      type: float
      source variable: ObsErrorData/specificHumidityAt2M

  - filter: Perform Action
    filter variables:
    - name: specificHumidityAt2M
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorSatSpecHumidity
        options:
          variable: specificHumidityAt2M
          input_error_name: RelativeHumidityObsError
          surface observation types: {{ assim_obstypes }}
          surface saturation specific humidity:
            name: GeoVaLs/saturation_water_vapor_mixing_ratio_wrt_moist_air_at_2m

  - filter: Perform Action
    filter variables:
    - name: specificHumidityAt2M
    where:
    - variable: ObsErrorData/specificHumidityAt2M
      maxvalue: 1.0e-4
    action:
      name: assign error
      error parameter: 1.0e-4

{% for var in assim_variables %}
  - filter: Variable Assignment
    assignments:
    - name: InputObsError/{{ var }}
      type: float
      source variable: ObsErrorData/{{ var }}
{% endfor %}

  # apply error inflation terms
  # ---------------------------------

{% for var in assim_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 3, 7
    action:
      name: inflate error
      inflation factor: 1.2
{% endfor %}

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    action:
      name: inflate error
      inflation variable:
        name: ObsFunction/ObsErrorFactorSfcPressure
        options:
          geovar_sfc_geomz: height_above_mean_sea_level_at_surface
          geovar_geomz: geopotential_height
          station_altitude: height
          observed temperature variable: MetaData/airTemperatureAt2MObserved

  # order matters - adjust obs to the model terrain height (here), then
  # inflate obs errors for the adjustment and apply O-F checks
  - filter: Variable Assignment
    assignments:
    - name: DerivedObsValue/airTemperatureAt2M
      type: float
      function:
        name: ObsFunction/ModelHeightAdjustedAirTemperature
        options:
          observed temperature variable: ObsValue/airTemperatureAt2M
          elevation:
            name: MetaData/stationElevation
          temperature lapse rate in K/km:
            scheme: constant
            value: 4.5

  # order matters - adjust obs to the model terrain height, then inflate obs
  # errors for the adjustment (here)
  - filter: Perform Action
    filter variables:
    - name: airTemperatureAt2M
    action:
      name: assign error
      error function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          - name: ObsErrorData/airTemperatureAt2M
          - name: DerivedMetaData/stationMinusModelHeight
          coefs: [1.0, 0.00225]
          absolute value: [false, true]

  # order matters - adjust obs to the model terrain height (here), then
  # inflate obs errors for the adjustment and apply O-F checks
  - filter: Variable Assignment
    assignments:
    - name: DerivedMetaData/airTemperatureAt2MModelAtStation
      type: float
      function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          - name: GeoVaLs/air_temperature_at_2m
          - name: MetaData/stationElevation
          - name: GeoVaLs/height_above_mean_sea_level_at_surface
          coefs: [1.0, -0.0045, 0.0045]

  # order matters - adjust obs to the model terrain height, then inflate obs
  # errors for the adjustment (here)
  - filter: Variable Assignment
    assignments:
    - name: DerivedObsValue/specificHumidityAt2M
      type: float
      function:
        name: ObsFunction/ModelHeightAdjustedSpecificHumidity
        options:
          observed specific humidity variable: MetaData/specificHumidityAt2MObserved
          observed temperature variable: DerivedMetaData/airTemperatureAt2MModelAtStation
          adjusted temperature variable: GeoVaLs/air_temperature_at_2m
          station pressure variable: GeoVaLs/air_pressure_at_surface

  - filter: Variable Assignment
    assignments:
    - name: DerivedMetaData/specificHumidityAt2MTerrainAdjustment
      type: float
      function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          - name: DerivedObsValue/specificHumidityAt2M
          - name: MetaData/specificHumidityAt2MObserved
          coefs: [1.0, -1.0]

  - filter: Perform Action
    filter variables:
    - name: specificHumidityAt2M
    action:
      name: assign error
      error function:
        name: ObsFunction/Arithmetic
        options:
          variables:
          - name: ObsErrorData/specificHumidityAt2M
          - name: DerivedMetaData/specificHumidityAt2MTerrainAdjustment
          coefs: [1.0, 0.5]
          absolute value: [false, true]

  # Observation Post Filters (QC)
  # -----------------------------

  obs post filters:

  # background checks
  # ---------------------------------

  - filter: Background Check
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_not_in: 3
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: stationPressure
        obserr_bound_min: 100
        obserr_bound_max: 300
        obserr_bound_factor: 5.0
    action:
      name: reject

  - filter: Background Check
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_in: 3
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: stationPressure
        obserr_bound_min: 100
        obserr_bound_max: 300
        obserr_bound_factor: 3.5
    action:
      name: reject

  # GSI gross check (convinfo: gross 5.0, ermin = ermax = 2.0):
  # the error is always clamped to 2.0, so reject |O-B| > 2.0 * 5.0
  - filter: Background Check
    filter variables:
    - name: airTemperatureAt2M
    where:
    - variable: QualityMarker/airTemperatureAt2M
      is_not_in: 3
    absolute threshold: 10.0
    action:
      name: reject

  # GSI tightens the gross limit for QM=3 obs: reject |O-B| > 2.0 * (0.7 * 5.0)
  - filter: Background Check
    filter variables:
    - name: airTemperatureAt2M
    where:
    - variable: QualityMarker/airTemperatureAt2M
      is_in: 3
    absolute threshold: 7.0
    action:
      name: reject

  # GSI gross check (convinfo: gross 5.0, ermin = ermax = 10% RH):
  # the error is always clamped to 0.1 * qsat, so reject |O-B| > 0.1 * 5.0 * qsat
  - filter: Background Check
    filter variables:
    - name: specificHumidityAt2M
    where:
    - variable: QualityMarker/specificHumidityAt2M
      is_not_in: 3
    function absolute threshold:
    - name: ObsFunction/Arithmetic
      options:
        variables:
        - name: GeoVaLs/saturation_water_vapor_mixing_ratio_wrt_moist_air_at_2m
        coefs: [0.5]
    action:
      name: reject

  # GSI tightens the gross limit for QM=3 obs: reject |O-B| > 0.1 * (0.7 * 5.0) * qsat
  - filter: Background Check
    filter variables:
    - name: specificHumidityAt2M
    where:
    - variable: QualityMarker/specificHumidityAt2M
      is_in: 3
    function absolute threshold:
    - name: ObsFunction/Arithmetic
      options:
        variables:
        - name: GeoVaLs/saturation_water_vapor_mixing_ratio_wrt_moist_air_at_2m
        coefs: [0.35]
    action:
      name: reject

  # Apply duplicate error inflation
  # ---------------------------------

  # TURN OFF FOR TESTING l_closeobs=False (temporal filter, instead of error inflation)
  # order matters - compute duplicate check, then apply O-F check
  # using initial errors, then apply duplicate error inflation (here)
  #- filter: Perform Action
  #  filter variables:
  #  - name: stationPressure
  #  action:
  #    name: inflate error
  #    inflation variable:
  #      name: ObsErrorFactorDuplicateCheck/stationPressure

  # End of Filters

  # GeoVaLs for Driving Observation Operators (testing mode)
  # --------------------------------------------------------
  geovals:
    filename: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}_geoval{{atmosphere_obsdatain_suffix}}"

  # Passed benchmark for UFO testing
  # --------------------------------
  passedBenchmark: 0
