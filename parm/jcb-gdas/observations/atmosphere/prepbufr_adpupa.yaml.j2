-

  # Observation Space (I/O)
  # -----------------------
  obs space:
    name: {{observation_from_jcb}}
    obsdatain:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}{{atmosphere_obsdatain_suffix}}"
        missing file action: warn
      obsgrouping:
        group variables: ["stationIdentification"]
        sort variable: "pressure"
        sort order: "descending"
    obsdataout:
      engine:
        type: H5File
        obsfile: "{{atmosphere_obsdataout_path}}/{{atmosphere_obsdataout_prefix}}{{observation_from_jcb}}{{atmosphere_obsdataout_suffix}}"
    io pool:
      max pool size: 1
    simulated variables: [stationPressure, virtualTemperature, airTemperature]
    observed variables: [stationPressure, virtualTemperature, airTemperature]

  # Observation Operator
  # -------------------
  obs operator:
    name: Composite
    components:
    - name: SfcCorrected
      correction scheme to use: GSL
      station_altitude: height
      geovar_sfc_geomz: height_above_mean_sea_level_at_surface
      geovar_geomz: geopotential_height
      observed temperature variable: airTemperature
      observed specific humidity variable: specificHumidity
      variables:
      - name: stationPressure
    - name: VertInterp
      vertical coordinate: air_pressure
      observation vertical coordinate: pressure
      observation vertical coordinate group: MetaData
      interpolation method: log-linear
      variables:
      - name: virtualTemperature
      - name: airTemperature

  # Linear Observation Operator
  # ---------------------------
  linear obs operator:
    name: Composite
    components:
    - name: Identity
      variables:
      - name: stationPressure
    - name: VertInterp
      variables:
      - name: virtualTemperature
      - name: airTemperature

  # Observation Pre Filters (QC)
  # ------------------------------

{% set temperature_variables = ['virtualTemperature', 'airTemperature'] %}
{% set assim_variables = ['stationPressure'] + temperature_variables %}
{% set assim_obstypes         = [120] %}

  obs pre filters:

  # remove all records not in desired obs type from obs space
  # reject all obs not of desired variable
  # --------------------------------
 
  - filter: Perform Action
    where:
    - variable:
        name: ObsType/pressure # hard-coded, as files don't have ObsType/stationPressure
      is_not_in: {{ assim_obstypes | join(', ') }}
    action:
      name: reduce obs space

  # Reject everything, then re-accept desired variables
  - filter: RejectList
    udescriptor: "reject_all"

{% for var in assim_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: accept
{% endfor %}

  # Observation Prior Filters (QC)
  # ------------------------------

  obs prior filters:

  # stationPressure error assignments
  # ---------------------------------

  - filter: Perform Action
    filter variables:
    - name: stationPressure
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorModelStepwiseLinear
        options:
          round_to_the_nearest_integer: true
          xvar:
            name: ObsValue/stationPressure
          xvals: [80000, 75000, 60000, 55000]
          errors: [110, 120, 120, 1.0e+11]

  # save initial error assignmnet
  - filter: Variable Assignment
    assignments:
    - name: InputObsError/stationPressure
      type: float
      source variable: ObsErrorData/stationPressure
 
  # Adjustments to obs errors
  - filter: Perform Action
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_in: 3
    action:
      name: inflate error
      inflation factor: 1.2

  # Compute and apply inflation factor from model-observation terrain mismatch
  - filter: Perform Action
    filter variables:
    - name: stationPressure
    action:
      name: inflate error
      inflation variable:
        name: ObsFunction/ObsErrorFactorSfcPressure
        options:
          geovar_sfc_geomz: height_above_mean_sea_level_at_surface
          geovar_geomz: geopotential_height
          station_altitude: height
          observed temperature variable: airTemperature
          observed specific humidity variable: specificHumidity
 
  # temperature error assignments
  # ---------------------------------

{% for var in temperature_variables %}
  - filter: Variable Assignment
    assignments:
    - name: InputObsError/{{ var }}
      type: float
      source variable: ObsErrorData/{{ var }}

  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 3, 7
    action:
      name: inflate error
      inflation factor: 1.2

  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    where:
    - variable: MetaData/pressure
      maxvalue: 9999.0
    action:
      name: inflate error
      inflation factor: 1.2

  - filter: Bounds Check
    filter variables:
    - name: {{ var }}
    test variables:
    - name: ObsErrorData/{{ var }}
    minvalue: 0.0
    maxvalue: 1000
{% endfor %}

  # order matters - Use the full T dry profile to compute error inflation (here)
  # then reject T dry where have T virtual.
  - filter: Variable Assignment
    assignments:
    - name: ErrormodFactor/airTemperature
      type: float
      function:
        name: ObsFunction/ObsErrorFactorConventional
        options:
          inflate variables: [airTemperature]
          pressure: MetaData/pressure

{% for var in temperature_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: inflate error
      inflation variable:
        name: ErrormodFactor/airTemperature
{% endfor %}

  # order matters - Use the full T dry profile to compute error inflation
  # then reject T dry where have T virtual (here)
  - filter: Perform Action
    filter variables:
    - name: airTemperature
    where:
    - variable: ObsValue/virtualTemperature
      value: is_valid
    action:
      name: reject

  # order matters - do after ErrormodFactor inflations
{% for var in temperature_variables %}
  - filter: Perform Action
    filter variables:
    - name: {{ var }}
    action:
      name: inflate error
      inflation variable:
        name: ObsFunction/ObsErrorFactorPressureCheck
        options:
          variable: {{ var }}
          surface observation error ramp: false
          inflation factor: 8.0
{% endfor %}

  # temperature QC
  # ---------------------------------

{% for var in temperature_variables %}
  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 8-15
      value: is_not_valid
    where operator: or

  - filter: RejectList
    filter variables:
    - name: {{ var }}
    where:
    - variable: QualityMarker/pressure
      is_in: 8-15

  - filter: Bounds Check
    filter variables:
    - name: {{ var }}
    minvalue: 100
    maxvalue: 400
{% endfor %}
  
  # stationPressure QC
  # ---------------------------------

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: ObsValue/stationPressure
      maxvalue: 50000.00

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: QualityMarker/stationPressure
      is_not_in: 0-3

  - filter: RejectList
    filter variables:
    - name: stationPressure
    where:
    - variable:
        name: QualityMarker/height
      is_in: 7, 8, 10-14

  # temporal thinning
  # ---------------------------------

  # TURN ON FOR TESTING l_closeobs=True (temporal filter, instead of error inflation)
  - filter: Temporal Thinning
    filter variables:
    - name: virtualTemperature
    - name: airTemperature
    category_variable:
      name: MetaData/stationIdentification
    records_are_single_obs: true
    min_spacing: PT6H
    seed_time: '{{ atmosphere_background_time_iso }}'
    action:
      name: reject

  - filter: Temporal Thinning
    filter variables:
    - name: stationPressure
    category_variable: MetaData/stationIdentification
    min_spacing: PT6H
    seed_time: '{{ atmosphere_background_time_iso }}'
    action:
      name: reject

  # TURN OFF FOR TESTING, l_closeobs=False 
  # order matters - compute duplicate check (here) then apply O-F check 
  # using initial errors, then apply duplicate error inflation
  #- filter: Variable Assignment
  #  assignments:
  #  - name: ObsErrorFactorDuplicateCheck/stationPressure
  #    type: float
  #    function:
  #      name: ObsFunction/ObsErrorFactorDuplicateCheck
  #      options:
  #        use_air_pressure: false
  #        variable: stationPressure

  # Observation Post Filters (QC)
  # -----------------------------

  obs post filters:

  # stationPressure background checks
  # ---------------------------------

  - filter: Background Check
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_not_in: 3
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: stationPressure
        obserr_bound_min: 100
        obserr_bound_max: 300
        obserr_bound_factor: 5.0
    action:
      name: reject

  - filter: Background Check
    filter variables:
    - name: stationPressure
    where:
    - variable: QualityMarker/stationPressure
      is_in: 3
    function absolute threshold:
    - name: ObsFunction/ObsErrorBoundConventional
      options:
        obsvar: stationPressure
        obserr_bound_min: 100
        obserr_bound_max: 300
        obserr_bound_factor: 3.5
    action:
      name: reject

  # TURN OFF FOR TESTING l_closeobs=False (temporal filter, instead of error inflation)
  # order matters - compute duplicate check, then apply O-F check 
  # using initial errors, then apply duplicate error inflation (here)
  #- filter: Perform Action
  #  filter variables:
  #  - name: stationPressure
  #  action:
  #    name: inflate error
  #    inflation variable:
  #      name: ObsErrorFactorDuplicateCheck/stationPressure


  # temperature background checks
  # ---------------------------------

  # GSI gross check values (convinfo: gross 8.0, ermax 5.6, ermin 1.3) 
  # ignored ermin - since initial TOE is 2.0

{% for var in temperature_variables %}

  - filter: Background Check
    filter variables:
    - name: {{ var }}
    threshold: 8.0
    absolute threshold: 44.8  # 8.0 * 5.6
    where:
    - variable: QualityMarker/{{ var }}
      is_not_in: 3
    action:
      name: reject

  - filter: Background Check
    filter variables:
    - name: {{ var }}
    threshold: 5.6
    absolute threshold: 31.36  # 5.6 * 5.6
    where:
    - variable: QualityMarker/{{ var }}
      is_in: 3
    action:
      name: reject

{% endfor %}

  # End of Filters

  # GeoVaLs for Driving Observation Operators (testing mode)
  # --------------------------------------------------------
  geovals:
    filename: "{{atmosphere_obsdatain_path}}/{{atmosphere_obsdatain_prefix}}{{observation_from_jcb}}_geoval{{atmosphere_obsdatain_suffix}}"

  # Passed benchmark for UFO testing
  # --------------------------------
  passedBenchmark: 0
