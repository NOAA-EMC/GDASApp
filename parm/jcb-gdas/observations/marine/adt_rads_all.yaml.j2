- obs space:
    name: {{observation_from_jcb}}
    obsdatain:
      engine:
        type: H5File
        obsfile: "{{marine_obsdatain_path}}/{{marine_obsdatain_prefix}}{{observation_from_jcb}}{{marine_obsdatain_suffix}}"
        missing file action: warn
    obsdataout:
      engine:
        type: H5File
        obsfile: "{{marine_obsdataout_path}}/{{marine_obsdataout_prefix}}{{observation_from_jcb}}{{marine_obsdataout_suffix}}"
    simulated variables: [absoluteDynamicTopography]
    io pool:
      max pool size: 1
{% if marine_letkf_app | default(false) %}
    distribution:
      name: Halo
      halo size: {{ marine_letkf_dist_halo_size }}
{% endif %}
  get values:
    time interpolation: linear
  obs operator:
    name: ADT
  obs error:
    covariance model: diagonal
  obs filters:
  - filter: Domain Check
    where:
    - variable: {name: GeoVaLs/sea_area_fraction}
      value: is_valid
      minvalue: 0.9
  - filter: Domain Check
    where:
    - variable: { name: GeoVaLs/sea_surface_temperature}
      minvalue: 0.0
  # Background check: 0.1 m everywhere, 0.3 m inside the major boundary
  # currents. There the background front sits 50-100 km off, so |o-b| is
  # large for reasons unrelated to the obs, and a 0.1 m check rejects ~47% of
  # the obs against ~16% elsewhere. The check is still the only guard against
  # badly calibrated tracks, so it is relaxed only inside the boxes.
  #
  # Boxes were fitted to the 0.1 m rejection-rate map of cp06.torchbalance.4
  # (31 cycles, 20251214-20260113, debug-adt/wbc_boxes.py): several per
  # current, following the path and its meander envelope, with the shelves
  # (Yellow/East China Sea, northern and West Florida Gulf, Patagonia inshore
  # of the Malvinas shelf break) kept out. They hold 6.2% of the obs and 16%
  # of the rejections. At 0.3 m the in-box rejection falls to ~15%, i.e. the
  # same rate as outside the boxes at 0.1 m.
  # [lat_min, lat_max, lon_min, lon_max], lon in -180..180
  {% set adt_wbc_boxes = [
    [ 25.0,  31.0,  -80.5,  -77.5],
    [ 31.0,  36.5,  -78.5,  -71.0],
    [ 34.0,  41.0,  -73.0,  -64.0],
    [ 35.5,  43.5,  -64.0,  -50.0],
    [ 38.0,  46.0,  -50.0,  -42.0],
    [ 44.0,  52.0,  -46.0,  -38.0],
    [ 42.0,  50.0,  -38.0,  -30.0],
    [ 22.0,  28.0,  -90.0,  -84.0],
    [ 29.0,  34.5,  131.0,  140.0],
    [ 32.0,  40.0,  140.0,  150.0],
    [ 32.0,  40.0,  150.0,  160.0],
    [ 32.0,  39.5,  160.0,  175.0],
    [ 34.0,  40.5,  175.0,  180.0],
    [ 34.0,  40.5, -180.0, -175.0],
    [-31.0, -26.0,   31.0,   37.0],
    [-35.5, -31.0,   26.0,   32.0],
    [-43.5, -34.0,   10.0,   30.0],
    [-43.0, -36.0,   30.0,   50.0],
    [-46.0, -37.5,   50.0,   60.0],
    [-47.0, -40.0,   60.0,   70.0],
    [-46.0, -38.0,  -61.0,  -58.0],
    [-49.0, -35.0,  -58.0,  -47.0],
    [-50.0, -40.0,  -47.0,  -38.0],
    [-52.0, -44.5,  -38.0,  -30.0],
    [-32.0, -28.0,  153.0,  159.5],
    [-36.0, -32.0,  150.5,  162.0],
    [-40.0, -36.0,  149.5,  155.0],
  ] %}
  # Gulf Stream (4), N Atlantic Current (3), Loop Current (1), Kuroshio and
  # Extension (6), Agulhas / retroflection / Return Current (6),
  # Brazil-Malvinas (4), East Australian Current (3).
  - filter: Background Check
    filter variables:
    - name: absoluteDynamicTopography
    function absolute threshold:
    - name: ObsFunction/Conditional
      options:
        defaultvalue: 0.1
        cases:
{% for b in adt_wbc_boxes %}
        - where:
          - variable: {name: MetaData/latitude}
            minvalue: {{ b[0] }}
            maxvalue: {{ b[1] }}
          - variable: {name: MetaData/longitude}
            minvalue: {{ b[2] }}
            maxvalue: {{ b[3] }}
          value: 0.3
{% endfor %}
  #- filter: Domain Check
  #  where:
  #  - variable: {name: GeoVaLs/sea_floor_depth_below_sea_surface}
  #    minvalue: 500

  - filter: Perform Action
    filter variables:
    - name: absoluteDynamicTopography
    action:
      name: assign error
      error parameter: 0.1

  # Flow-dependent sigo: shrink the error where the ADT gradient is large, so
  # the analysis draws harder to the altimeter in the energetic regions.
  # Geostrophy gives |grad(eta)| = (f/g)|u_surf|, so the background surface
  # speed stands in for the gradient. Caveat that comes with it: the reduction
  # lands where the MODEL puts the current, not where it actually is. That is
  # why x0 is deliberately low (~global p60 of speed at obs locations) and the
  # ramp is broad -- the reduced-sigo footprint then covers the whole energetic
  # surround, not just the jet core, so the 50-100 km axis error we measured in
  # the frontal analysis still falls inside it. Do not sharpen this ramp.
  #
  # ObsErrorModelRamp is a *decaying* ramp (err1 < err0) clamped outside
  # [x0, x1], so 0.03 m is a hard floor. That floor is the along-track
  # altimeter noise level: in fronts we trust the obs to its own instrumental
  # accuracy and nothing tighter.
  #
  #   |u| <= 0.10 m/s -> 0.100 m   quiet ocean, unchanged
  #   |u| =  0.25 m/s -> 0.074 m   WBC median                ~1.8x the weight
  #   |u| >= 0.50 m/s -> 0.030 m   jet cores                 11.1x the weight
  #
  # Measured on 20251217/00 (7 satellites, model background surface speed
  # sampled at the obs locations): 35% of obs keep 0.1 m, 3.6% reach the floor,
  # global mean weight change x2.0. Median assigned sigo by region --
  # Agulhas 0.048, Brazil/Malvinas 0.062, EAC 0.071, Kuroshio 0.072,
  # ACC-Indian 0.075, Gulf Stream 0.076, quiet N.Pac 0.091.
  #
  # The |lat| >= 10 guard is NOT optional. Equatorward of that, f -> 0 and the
  # surface flow is fast while the ADT gradient is not: measured median model
  # speed is 0.43 m/s at |lat| < 3, ABOVE the Gulf Stream's 0.24 m/s. Without
  # the guard, 41% of equatorial obs hit the 0.03 m floor against 17% in the
  # Gulf Stream, i.e. the scheme would mostly re-weight the tropics. By
  # |lat| 10-15 the median speed is back to 0.236 m/s, indistinguishable from
  # a mid-latitude WBC, so 10 degrees is where the guard belongs.
  #
  # The sigo reduction does not change QC: the Background Check above uses
  # absolute thresholds, which BackgroundCheck.cc keeps independent of ObsError.
  # Only the boundary-current boxes loosen it.
  - filter: Perform Action
    filter variables:
    - name: absoluteDynamicTopography
    where:
    - variable: {name: MetaData/latitude}
      maxvalue: -10.0
    - variable: {name: MetaData/latitude}
      minvalue: 10.0
    where operator: or
    action:
      name: assign error
      error function:
        name: ObsFunction/ObsErrorModelRamp
        options:
          save: true
          xvar:
            name: ObsFunction/Arithmetic
            options:
              variables:
              - GeoVaLs/surface_eastward_sea_water_velocity
              - GeoVaLs/surface_northward_sea_water_velocity
              exponents: [2, 2]
              total exponent: 0.5
          x0:   [0.10]
          x1:   [0.50]
          err0: [0.10]
          err1: [0.03]

  #- filter: Perform Action
  #  action:
  #    name: assign error
  #    error function:
  #      name: ObsFunction/LinearCombination
  #      options:
  #        variables: [GeoVaLs/mesoscale_representation_error,
  #                    ObsError/absoluteDynamicTopography]
  #        coefs: [0.0,
  #                1.0]
  - filter: Domain Check
    where:
    - variable: { name: GeoVaLs/sea_ice_area_fraction}
      maxvalue: 0.00001
  - filter: Domain Check
    where:
    - variable: {name: GeoVaLs/distance_from_coast}
      minvalue: 25e3
#  - filter: BlackList
#    where:
#    - variable:
#        name: MetaData/latitude
#      minvalue: 4
#      maxvalue: 30
#    - variable:
#        name: MetaData/longitude
#      minvalue: 32
#      maxvalue: 56
{% if marine_letkf_app | default(false) %}
  obs localizations:
  - localization method: Rossby
    base value: 100.0e3
    rossby mult: 1.0
    min grid mult: 2.0
    min value: 200.0e3
    max value: 900.0e3
{% endif %}
