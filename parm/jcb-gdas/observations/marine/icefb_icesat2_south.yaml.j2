- obs space:
    name: {{observation_from_jcb}}
    obsdatain:
      engine:
        type: H5File
        obsfile: "{{marine_obsdatain_path}}/{{marine_obsdatain_prefix}}{{observation_from_jcb}}{{marine_obsdatain_suffix}}"
        missing file action: warn
    obsdataout:
      engine:
        type: H5File
        obsfile: "{{marine_obsdataout_path}}/{{marine_obsdataout_prefix}}{{observation_from_jcb}}{{marine_obsdataout_suffix}}"
    simulated variables: [seaIceFreeboard]
    io pool:
      max pool size: 1
{% if marine_letkf_app | default(false) %}
    distribution:
      name: Halo
      halo size: {{ marine_letkf_dist_halo_size }}
{% endif %}
  get values:
    time interpolation: linear
  obs operator:
    name: SeaIceFreeboard
    instrument: lidar
    sea ice density: 917.0
    surface snow density: 330.0
    sea water density: 1026.0
  obs error:
    covariance model: diagonal

  obs pre filters:
  # Reject obs flagged by the upstream ICESat-2 processing
  - filter: PreQC
    filter variables:
    - name: seaIceFreeboard
    maxvalue: 1
    action:
      name: reject

  # Physical range test on the reported freeboard
  - filter: Bounds Check
    filter variables:
    - name: seaIceFreeboard
    minvalue: 0.0
    maxvalue: 1.0
    action:
      name: reject
{% if marine_letkf_app | default(false) %}

  # Thin the dense along-track sampling; must stay a pre filter since
  # the "reduce obs space" action is not implemented for prior/post stages
  - filter: Gaussian Thinning
    horizontal_mesh: 25  #km
    use_reduced_horizontal_grid: true
    select_median: true
    action:
      name: reduce obs space
{% endif %}

  obs prior filters:
  - filter: Domain Check
    where:
    - variable: {name: GeoVaLs/sea_area_fraction}
      value: is_valid
      minvalue: 0.9

  - filter: Domain Check
    where:
    - variable: {name: GeoVaLs/sea_ice_area_fraction}
      minvalue: 0.5

  obs post filters:
  - filter: Background Check
    filter variables:
    - name: seaIceFreeboard
    absolute threshold: 0.1

  # Add a constant to the error read from the file -- a floor on how well
  # the freeboard can be believed, independent of how small the reported
  # error happens to be. Additive in the standard deviation, not the
  # variance: 0.05 m of freeboard.
  #
  # `ObsError/` is the ORIGINAL error from the file, so this is not
  # cumulative with a rerun. `assign error` overwrites, so this filter must
  # stay LAST among the error filters -- anything added after it replaces
  # this rather than compounding it.
  - filter: Perform Action
    filter variables:
    - name: seaIceFreeboard
    action:
      name: assign error
      error function:
        name: ObsFunction/Arithmetic
        options:
          # sigo_total = 1.0 * sigo_original + 0.05
          variables: [ObsError/seaIceFreeboard]
          coefs:     [1.0]
          intercept: 0.05

{% if marine_letkf_app | default(false) %}
  obs localizations:
  - localization method: Rossby
    base value: 100.0e3
    rossby mult: 1.0
    min grid mult: 2.0
    min value: 200.0e3
    max value: 900.0e3
{% endif %}
