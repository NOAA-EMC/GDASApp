geometry:
  geometry_type: fv3
  fms initialization:
    namelist filename: "{{aero_fv3jedi_files_path}}/fmsmpp.nml"
    field table filename: "{{aero_fv3jedi_files_path}}/field_table"
  akbk: "{{aero_fv3jedi_files_path}}/akbk.nc4"
  layout:
  - {{aero_layout_x}}
  - {{aero_layout_y}}
  npx: {{aero_npx_ges}}
  npy: {{aero_npy_ges}}
  npz: {{aero_npz_ges}}
  ntiles: {{ aeroijedi_ntiles | default(6) }}
variables: {{ aero_det_increment_variables }}
times: ['{{ aero_cycle_time_iso }}']
io:
  filetype: fv3 restart
  datapath: {{ aero_analysis_path }}
  prefix: aeroinc
  filename_core: 'aeroinc.{{ aero_cycle_time_fv3 }}.fv_core.res.nc'
  filename_trcr: 'aeroinc.{{ aero_cycle_time_fv3 }}.fv_tracer.res.nc'
  filename_cplr: 'aeroinc.{{ aero_cycle_time_fv3 }}.coupler.res'
  field io names: {{ aero_field_io_names_crtm }}
