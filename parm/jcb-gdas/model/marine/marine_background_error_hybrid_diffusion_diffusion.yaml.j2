# Pure ensemble covariance with BUMP/NICAS localization, ported from
# John.Steffen's envar.yaml (envar_L300), where it was validated by a dirac
# test. This replaces the previous hybrid (static diffusion + diffusion-
# localized ensemble): there is no static component and no BalanceSOCA
# linear variable change any more.
#
# NOTE: NICAS runs in calibration mode ('compute nicas: true'), so the
# parameters are recomputed every cycle rather than read from file. Nothing
# is written back ('write local nicas: false'), so the run is not tied to a
# particular MPI decomposition, but the calibration cost is paid each time.
covariance model: ensemble
members from template:
  template:
    read_from_file: 1
    date: '{{marine_stddev_time}}'
    basename: ../ensdata/
    ocn_filename: ocn.pert.%mem%.nc
    ice_filename: ice.pert.%mem%.nc
    state variables:
    - sea_water_potential_temperature
    - sea_water_salinity
    - eastward_sea_water_velocity
    - northward_sea_water_velocity
    - sea_surface_height_above_geoid
    - sea_ice_area_fraction
    - sea_ice_thickness
    - sea_ice_snow_thickness
  pattern: '%mem%'
  nmembers: '{{marine_number_ensemble_members}}'
  zero padding: 0

localization:
  localization method: SABER
  saber central block:
    saber block name: BUMP_NICAS
    calibration:
      drivers:
        multivariate strategy: duplicated
        compute nicas: true
        write local nicas: false
      general:
        universe length-scale: 10000.0e3
      model:
        do not cross mask boundaries: true
        groups:
        - group name: ocean3d
          variables:
          - sea_water_potential_temperature
          - sea_water_salinity
          - eastward_sea_water_velocity
          - northward_sea_water_velocity
        - group name: surf2d
          variables:
          - sea_ice_area_fraction
          - sea_ice_thickness
          - sea_ice_snow_thickness
          - sea_surface_height_above_geoid
      nicas:
        resolution: 5.0
        smooth interpolation factor: 0.5
        min effective resolution: 2.7
        max horizontal grid size: 242203
        grid type: octahedral
        explicit length-scales: true
        horizontal length-scale:
        - groups:
          - ocean3d
          - surf2d
          value: 300000.0
        vertical length-scale:
        - groups:
          - ocean3d
          value: 10.0
