{# The filenames are overridable because the background is not always the window-begin
   restart pair: coupled 3D-Var solves for a single state at the window middle, so it
   points these at the f006 history instead. #}
read_from_file: 1
basename: {{ marine_background_path}}
ocn_filename: {{ marine_background_ocn_filename | default('MOM.res.nc', true) }}
ice_filename: {{ marine_background_ice_filename | default('cice.res.nc', true) }}
date: "{{ marine_background_time }}"
state variables: {{ marine_det_state_variables }}
