name: PseudoModel
tstep: {{marine_forecast_timestep}}
states:
{% for marine_pseudo_model_state in marine_pseudo_model_states %}
- date: '{{ marine_pseudo_model_state.date }}'
  state variables: {{ marine_ijedi_background_variables }}
  derived variables: {{ marine_ijedi_background_derived_variables }}
  io:
    filetype: mom6
    datapath: '{{ marine_pseudo_model_state.basename }}'
    ocn_file: '{{ marine_pseudo_model_state.ocn_filename }}'
    ice_file: '{{ marine_pseudo_model_state.ice_filename }}'
    field io names: {{ marine_ijedi_background_io_names }}
{% endfor %}
