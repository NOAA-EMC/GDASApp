{# Coupled 3D-Var outer loop (single iteration). Unlike the single-component outer
   loops, coupled DA uses one shared geometry and one minimizer. The inner loop runs on
   the coupled analysis geometry, built from each component's own inner-loop geometry. #}
- ninner: {{coupled_ninner_1}}
  gradient norm reduction: {{coupled_grad_red_1}}
  test: on
  geometry:
{% filter indent(width=4) %}
{% for component in coupled_components %}
{{ component.name }}:
{% filter indent(width=2) %}
{% include component.dir ~ '_geometry_analysis.yaml.j2' %}
{% endfilter %}
{% endfor %}
{% include 'coupled_geometry_options.yaml.j2' %}
{% endfilter %}
  diagnostics:
    departures: {{coupled_outer_loop_departures | default('bkgmob', true)}}
