{# Body of one coupled 3D-Var outer loop. Unlike the single-component outer loops, coupled DA
   uses one shared geometry (the full coupled geometry) and one minimizer.

   Not included directly by the 3dvar algorithm: that includes coupled_3dvar_outer_loop_<n>,
   which sets coupled_loop_* for its own loop index and then includes this file. #}
- ninner: {{ coupled_loop_ninner }}
  gradient norm reduction: {{ coupled_loop_grad_red }}
  test: on
  geometry:
{% filter indent(width=4) %}
{% include 'coupled_geometry_background.yaml.j2' %}
{% endfilter %}
  diagnostics:
    departures: {{ coupled_loop_departures }}
