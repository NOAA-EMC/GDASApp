output:
  date: '{{ marineijedi_window_begin }}'
  io:
    filetype: mom6
    datapath: {{ marineijedi_final_increment_dir }}
    ocn_file: {{ marineijedi_final_increment_exp }}.incr.nc
    field io names:
      sea_water_potential_temperature: Temp
      sea_water_salinity: Salt
      sea_surface_height_above_geoid: ave_ssh
geometry:
  geometry_type: mom6
  ocean_hgrid: {{ marineijedi_ocean_hgrid }}
  ocean_topog: {{ marineijedi_ocean_topog }}
  vertical geometry from: {{ marineijedi_vertical_geometry_from }}
  coarsen factor: {{ marineijedi_coarsen_factor | default(1) }}
  has northern fold: {{ marineijedi_has_northern_fold | default(true) }}
  MOM_input:
    NIGLOBAL: {{ marineijedi_niglobal }}
    NJGLOBAL: {{ marineijedi_njglobal }}
    NZ: {{ marineijedi_nz }}
    LAYOUT: {{ marineijedi_layout }}
    MINIMUM_DEPTH: {{ marineijedi_minimum_depth | default(0.5) }}
