jedi_config:
    atmanlvar:
        rundir: '{{ DATA }}'
        exe_src: '{{ EXECglobal }}/gdas.x'
        mpi_cmd: '{{ APRUN_ATMANLVAR }}'
        jedi_args: ['fv3jedi', 'variational']
        jcb_algo: '3dvar'
        jcb_base_yaml: '{{ PARMglobal }}/gdas/atm/jcb-base.yaml.j2'
        obs_list_yaml: '{{ OBS_LIST_YAML }}'
        app_test_yaml: '{{ VAR_JEDI_TEST_YAML }}'
    atmanlfv3inc:
        rundir: '{{ DATA }}'
        exe_src: '{{ EXECglobal }}/gdas_fv3jedi_fv3inc.x'
        mpi_cmd: '{{ APRUN_ATMANLFV3INC }}'
        jcb_algo: 'fv3jedi_fv3inc_variational'
        jcb_base_yaml: '{{ PARMglobal }}/gdas/atm/jcb-base.yaml.j2'
        app_test_yaml: '{{ FV3INC_JEDI_TEST_YAML }}'

data_in:
    mkdir:
    - '{{ DATA }}/bkg'
    - '{{ DATA }}/anl'
    - '{{ DATA }}/fv3jedi'
    - '{{ DATA }}/crtm'
    - '{{ DATA }}/berror'

{% if DOHYBVAR %}
    {% for imem in range(1,NMEM_ENS+1) %}
    - '{{ DATA }}/ens/{{ 'mem%03d' | format(imem) }}'
    {% endfor %}
{% endif %}

    copy_req:
    - ['{{ COMIN_ATMOS_HISTORY_PREV }}/{{ GPREFIX }}csg_atm.f006.nc', '{{ DATA }}/bkg/{{ GPREFIX }}cubed_sphere_grid_atmf006.nc']
    - ['{{ COMIN_ATMOS_HISTORY_PREV }}/{{ GPREFIX }}csg_sfc.f006.nc', '{{ DATA }}/bkg/{{ GPREFIX }}cubed_sphere_grid_sfcf006.nc']

{% if DOHYBVAR %}
    {% for imem in range(1,NMEM_ENS+1) %}
        {% set tmpl_dict = ({ '${ROTDIR}': ROTDIR,
                              '${RUN}': 'enkfgdas',
                              '${YMD}': previous_cycle | to_YMD,
                              '${HH}': previous_cycle | strftime('%H'),
                              '${MEMDIR}': 'mem%03d' | format(imem) }) %}
        {% if LOCALIZATION_TYPE is not defined or LOCALIZATION_TYPE == 'bump' %}
    - ['{{ COM_ATMOS_HISTORY_TMPL | replace_tmpl(tmpl_dict) }}/{{ GPREFIX_ENS }}csg_atm.f006.nc', '{{ DATA }}/ens/{{ 'mem%03d' | format(imem) }}/{{ GPREFIX_ENS }}cubed_sphere_grid_atmf006.nc']
    - ['{{ COM_ATMOS_HISTORY_TMPL | replace_tmpl(tmpl_dict) }}/{{ GPREFIX_ENS }}csg_sfc.f006.nc', '{{ DATA }}/ens/{{ 'mem%03d' | format(imem) }}/{{ GPREFIX_ENS }}cubed_sphere_grid_sfcf006.nc']
        {% else %}
    - ['{{ COM_ATMOS_HISTORY_TMPL | replace_tmpl(tmpl_dict) }}/{{ GPREFIX_ENS }}atm.f006.nc', '{{ DATA }}/ens/{{ 'mem%03d' | format(imem) }}/{{ GPREFIX_ENS }}atm.f006.nc']
    - ['{{ COM_ATMOS_HISTORY_TMPL | replace_tmpl(tmpl_dict) }}/{{ GPREFIX_ENS }}sfc.f006.nc', '{{ DATA }}/ens/{{ 'mem%03d' | format(imem) }}/{{ GPREFIX_ENS }}sfc.f006.nc']
        {% endif %}
    {% endfor %}
{% endif %}

{% filter indent(width=4) %}
{% include 'atm_stage_jedi_fix.yaml.j2' %}
{% include 'atm_stage_crtm_coeff.yaml.j2' %}
{% if STATICB_TYPE != 'identity' %}
{% include 'atm_det_stage_berror_' ~ STATICB_TYPE ~ '.yaml.j2' %}
{% endif %}
{% endfilter %}

data_out:
    copy_req:
    - ['{{ DATA }}/atmanlvar.yaml', '{{ COMOUT_CONF }}/{{ APREFIX }}anlvar.atm.yaml']
    - ['{{ DATA }}/atmanlfv3inc.yaml', '{{ COMOUT_CONF }}/{{ APREFIX }}anlvar.fv3.atm.yaml']
    {% if ATMINC_GRID == 'gaussian' %}
    - ['{{ DATA }}/anl/atminc.{{ current_cycle | to_YMD }}_{{ current_cycle | strftime('%H') }}0000z.nc4', '{{ COMOUT_ATMOS_ANALYSIS }}/{{ APREFIX }}increment.atm.i006.nc']
    - ['{{ DATA }}/anl/cubed_sphere_grid_atminc.jedi.nc', '{{ COMOUT_ATMOS_ANALYSIS }}/{{ APREFIX }}jedi_increment.atm.i006.nc']
    {% else %}
    - ['{{ DATA }}/anl/{{ APREFIX }}cubed_sphere_grid_atminc.tile1.nc', '{{ COMOUT_ATMOS_ANALYSIS }}/{{ APREFIX }}jedi_increment.atm.i006.tile1.nc']
    - ['{{ DATA }}/anl/{{ APREFIX }}cubed_sphere_grid_atminc.tile2.nc', '{{ COMOUT_ATMOS_ANALYSIS }}/{{ APREFIX }}jedi_increment.atm.i006.tile2.nc']
    - ['{{ DATA }}/anl/{{ APREFIX }}cubed_sphere_grid_atminc.tile3.nc', '{{ COMOUT_ATMOS_ANALYSIS }}/{{ APREFIX }}jedi_increment.atm.i006.tile3.nc']
    - ['{{ DATA }}/anl/{{ APREFIX }}cubed_sphere_grid_atminc.tile4.nc', '{{ COMOUT_ATMOS_ANALYSIS }}/{{ APREFIX }}jedi_increment.atm.i006.tile4.nc']
    - ['{{ DATA }}/anl/{{ APREFIX }}cubed_sphere_grid_atminc.tile5.nc', '{{ COMOUT_ATMOS_ANALYSIS }}/{{ APREFIX }}jedi_increment.atm.i006.tile5.nc']
    - ['{{ DATA }}/anl/{{ APREFIX }}cubed_sphere_grid_atminc.tile6.nc', '{{ COMOUT_ATMOS_ANALYSIS }}/{{ APREFIX }}jedi_increment.atm.i006.tile6.nc']
    {% endif %}
