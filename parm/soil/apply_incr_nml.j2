&noahmp_soil
  date_str = "{{ current_cycle | to_YMD }}",
  hour_str = "{{ current_cycle | strftime('%H') }}",
  res = {{ CASE[1:] }},
  rst_path = "./anl",
  inc_path = "./anl",
  orog_path = "{{ HOMEglobal }}/fix/orog/{{ CASE }}",
  otype = "{{ CASE }}.mx{{ OCNRES }}_oro_data",
  stype_prefix="{{ CASE }}.mx{{ OCNRES }}.soil_type",
  ntiles={{ ntiles }},
  ens_size={{ ens_size }},
  upd_stc={{ upd_stc }},
  upd_slc={{ upd_slc }},
  print_summary=.true.,
  print_debug={{ print_debug }} ,
  lsoil_incr = {{ LSOIL_INCR }}, 
  inc_prefix = "{{ INC_PREFIX }}"
/
