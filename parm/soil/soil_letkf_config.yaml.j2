    - ['{{ DATA }}/anl/{{ memchar }}/{{ current_cycle | to_fv3time }}.sfc_data.tile6.nc',
       '{{ COM_ATMOS_ANALYSIS_TMPL | replace_tmpl(tmpl_dict) }}/soilanl.{{ current_cycle | to_fv3time }}.sfc_data.tile6.nc']
    {% endif %}
