# Deterministic coupled (FV3JEDI atmosphere + SOCA ocean/ice) analysis task config.
#
# Only coupledanlvar is a coupled application. The three post-processing apps stay
# single-component and reuse their own component's base verbatim.

jedi_config:
    coupledanlvar:
        rundir: '{{ DATA }}'
        exe_src: '{{ EXECglobal }}/gdas.x'
        mpi_cmd: '{{ APRUN_COUPLEDANLVAR }}'
        jedi_args: ['coupled', 'variational']
        jcb_algo: '3dvar'
        jcb_base_yaml: '{{ PARMglobal }}/gdas/coupled/jcb-base.yaml.j2'
        obs_list_yaml: '{{ OBS_LIST_YAML }}'
    coupledanlfv3inc:
        rundir: '{{ DATA }}'
        exe_src: '{{ EXECglobal }}/gdas_fv3jedi_fv3inc.x'
        mpi_cmd: '{{ APRUN_COUPLEDANLFV3INC }}'
        jcb_algo: 'fv3jedi_fv3inc_variational'
        jcb_base_yaml: '{{ PARMglobal }}/gdas/atm/jcb-base.yaml.j2'
    soca_incpostproc:
        rundir: '{{ DATA }}'
        exe_src: '{{ EXECglobal }}/gdas_soca_incr_handler.x'
        mpi_cmd: '{{ APRUN_COUPLEDANLCHKPT }}'
        jcb_algo: 'soca_incpostproc'
        jcb_base_yaml: '{{ PARMglobal }}/gdas/marine/jcb-base.yaml.j2'
    soca_diag_stats:
        rundir: '{{ DATA }}'
        exe_src: '{{ EXECglobal }}/gdas_soca_obsstats.x'
        mpi_cmd: '{{ APRUN_COUPLEDANLOBSSTATS }}'
        jcb_algo: 'soca_diag_stats'
        jcb_base_yaml: '{{ PARMglobal }}/gdas/marine/jcb-base.yaml.j2'

data_in:
    mkdir:
    # atmosphere
    - '{{ DATA }}/anl'
    - '{{ DATA }}/fv3jedi'
    - '{{ DATA }}/crtm'
    - '{{ DATA }}/berror'
    # marine
    - '{{ DATA }}/bkg'
    - '{{ DATA }}/INPUT'
    - '{{ DATA }}/anl_geom'
    - '{{ DATA }}/Data'

    copy_req:
    # stage soca grid
    - ['{{ COMIN_OCEAN_BMATRIX }}/soca_gridspec.nc', '{{ DATA }}']

    # stage CICE6 restart
    - ['{{ COMIN_ICE_RESTART_PREV }}/{{ rst_date }}.cice_model.res.nc', '{{ DATA }}/Data']

{% filter indent(width=4) %}
{% include PARMglobal ~ '/gdas/atm/atm_det_stage_bkg.yaml.j2' %}
{% include PARMglobal ~ '/gdas/atm/atm_stage_jedi_fix.yaml.j2' %}
{% include PARMglobal ~ '/gdas/atm/atm_stage_crtm_coeff.yaml.j2' %}
{% if STATICB_TYPE != 'identity' %}
{% include PARMglobal ~ '/gdas/atm/atm_det_stage_berror_' ~ STATICB_TYPE ~ '.yaml.j2' %}
{% endif %}
{% include PARMglobal ~ '/gdas/marine/marine_det_stage_bkg.yaml.j2' %}
{% include PARMglobal ~ '/gdas/marine/marine_stage_fix_' ~ '%03d'|format(OCNRES|int) ~ '.yaml.j2' %}
{% include PARMglobal ~ '/gdas/marine/marine_stage_utilities.yaml.j2' %}
{% endfilter %}

    link_req:
    # the SOCA static B, produced by marinebmat under the shared DATAjob root
    - ['{{ DATA }}/../staticb', '{{ DATA }}/staticb']

data_out:
    mkdir:
    - '{{ COMOUT_OCEAN_ANALYSIS }}/diags'
    - '{{ COMOUT_OCEAN_ANALYSIS }}/bump'

    copy_req:
    # generated JEDI configs
    - ['{{ DATA }}/coupledanlvar.yaml', '{{ COMOUT_CONF }}/{{ APREFIX }}anlvar.coupled.yaml']
    - ['{{ DATA }}/coupledanlfv3inc.yaml', '{{ COMOUT_CONF }}/{{ APREFIX }}anlvar.fv3.atm.yaml']

    # Ocean and sea ice products keep the marine chain's filenames, so everything downstream
    # of COM is unchanged. soca_genfilename names the JEDI increment and analysis after the
    # field's own valid time, which for 3D-Var is the window middle: the same time the
    # marine 3DFGAT writes them at.
{% filter indent(width=4) %}
{% include PARMglobal ~ '/gdas/marine/marine_det_save_anl.yaml.j2' %}
{% include PARMglobal ~ '/gdas/atm/atm_det_save_anl.yaml.j2' %}
{% endfilter %}
