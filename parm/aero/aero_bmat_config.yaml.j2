    - ['{{ COMIN_ATMOS_RESTART }}/{{ next_cycle | to_fv3time }}.fv_core.res.tile5.nc', '{{ DATA }}/bkg/']
    - ['{{ COMIN_ATMOS_RESTART }}/{{ next_cycle | to_fv3time }}.fv_core.res.tile6.nc', '{{ DATA }}/bkg/']

    - ['{{ COMIN_ATMOS_RESTART }}/{{ next_cycle | to_fv3time }}.fv_tracer.res.tile1.nc', '{{ DATA }}/bkg/']
