    - ['{{ DATA }}/stddev/{{ next_cycle | to_fv3time }}.stddev.fv_tracer.res.tile6.nc', '{{ COMOUT_CHEM_BMAT }}/{{ next_cycle | to_fv3time }}.stddev.fv_tracer.res.tile6.nc']
### copy coupler file
