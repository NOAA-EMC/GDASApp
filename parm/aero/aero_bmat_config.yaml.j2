data_out:
    copy:
### copy YAMLs used
    - ['{{ DATA }}/aero_interpbkg.yaml', '{{ COMOUT_CONF }}/{{ APREFIX }}aero_interpbkg.yaml']
    - ['{{ DATA }}/aero_diagb.yaml', '{{ COMOUT_CONF }}/{{ APREFIX }}aero_diagb.yaml']
    - ['{{ DATA }}/aero_diffusion.yaml', '{{ COMOUT_CONF }}/{{ APREFIX }}aero_diffusion.yaml']
### copy stddev files to ROTDIR
