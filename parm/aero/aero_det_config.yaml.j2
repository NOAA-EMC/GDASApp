    - ['{{ FIXCHEM }}/stddev.fv_tracer.res.tile1.nc', '{{ DATA }}/berror/{{ current_cycle | to_fv3time }}.stddev.fv_tracer.res.tile1.nc'']
    - ['{{ FIXCHEM }}/stddev.fv_tracer.res.tile2.nc', '{{ DATA }}/berror/{{ current_cycle | to_fv3time }}.stddev.fv_tracer.res.tile2.nc'']
    - ['{{ FIXCHEM }}/stddev.fv_tracer.res.tile3.nc', '{{ DATA }}/berror/{{ current_cycle | to_fv3time }}.stddev.fv_tracer.res.tile3.nc'']
    - ['{{ FIXCHEM }}/stddev.fv_tracer.res.tile4.nc', '{{ DATA }}/berror/{{ current_cycle | to_fv3time }}.stddev.fv_tracer.res.tile4.nc'']
