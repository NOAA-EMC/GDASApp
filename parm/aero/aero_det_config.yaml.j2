    - ['{{ COMIN_ATMOS_RESTART_PREV }}/{{ bkg_time | to_fv3time }}.fv_srf_wnd.res.tile6.nc', '{{ DATA }}/bkg/']
{% endfor %}

## copy backgrounds again for fv_tracer to create analysis files later
    - ['{{ COMIN_ATMOS_RESTART_PREV }}/{{ anl_time | to_fv3time }}.fv_tracer.res.tile1.nc', '{{ DATA }}/anl/']
    - ['{{ COMIN_ATMOS_RESTART_PREV }}/{{ anl_time | to_fv3time }}.fv_tracer.res.tile2.nc', '{{ DATA }}/anl/']
